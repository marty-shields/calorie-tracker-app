<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <!-- The kit comes from the Shields.UI package. -p:UseKitSource=true compiles against a checkout of the kit instead
       (KitPath, see Directory.Build.props); add -p:RestoreLockedMode=false, since the lock files describe the package. -->
  <ItemGroup Condition="'$(UseKitSource)' != 'true'">
    <PackageReference Include="Shields.UI" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseKitSource)' == 'true'">
    <ProjectReference Include="$(KitPath)/src/Shields.UI/Shields.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CalorieTracker.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CalorieTracker.Core\CalorieTracker.Core.csproj" />
  </ItemGroup>

</Project>
