@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Diary
@using Microsoft.Extensions.Logging
@inject TimeProvider Time
@inject ILogger<AddSheet> Logger

<Sheet Open="Open" Title="Add food" TestId="add-sheet" OnClose="DismissAsync">
    <div class="meals">
        <FilterChips TValue="Meal" Label="Meal" Options="Meals" Value="meal" ValueChanged="PickMeal" TestId="add-sheet-meals" />
    </div>
    <div class="tiles">
        <SheetAction Icon="IconName.Search" Label="Search foods" TestId="add-sheet-search" OnClick="() => ChooseAsync(AddSheetAction.Search, OnSearch)" />
        <SheetAction Icon="IconName.Scan" Label="Scan barcode" TestId="add-sheet-scan" OnClick="() => ChooseAsync(AddSheetAction.Scan, OnScan)" />
    </div>
    @if (Usual is { Count: > 0 } usual)
    {
        <section class="usual" aria-labelledby="add-sheet-usual-heading" data-testid="add-sheet-usual">
            <h3 id="add-sheet-usual-heading" class="usual-title" data-testid="add-sheet-usual-heading">Usual for @meal.ToString().ToLowerInvariant()</h3>
            <ul class="usual-rows">
                @foreach (var row in usual)
                {
                    <li class="usual-row" data-testid="@($"add-sheet-usual-{row.FoodId}")">
                        <div class="usual-text">
                            <span class="usual-name" data-testid="@($"add-sheet-usual-{row.FoodId}-title")" data-wrap-ok>@row.Title</span>
                            <span class="usual-detail" data-testid="@($"add-sheet-usual-{row.FoodId}-detail")" data-wrap-ok>@row.Detail</span>
                        </div>
                        <IconButton Style="IconButtonStyle.Soft" Icon="IconName.Plus" AriaLabel="@($"Add {row.Title} to {meal}")" TestId="@($"add-sheet-usual-{row.FoodId}-add")" OnClick="() => AddUsualAsync(row)" />
                    </li>
                }
            </ul>
        </section>
    }
    @if (AddError is not null)
    {
        <p class="add-error" role="alert" data-testid="add-sheet-add-error" data-wrap-ok>@AddError</p>
    }
</Sheet>

@code {
    private static readonly IReadOnlyList<RadioOption<Meal>> Meals =
    [
        new(Meal.Breakfast, "Breakfast", "add-sheet-meal-breakfast"),
        new(Meal.Lunch, "Lunch", "add-sheet-meal-lunch"),
        new(Meal.Dinner, "Dinner", "add-sheet-meal-dinner"),
        new(Meal.Snacks, "Snacks", "add-sheet-meal-snacks"),
    ];

    private Meal meal;
    private bool wasOpen;

    /// <summary>Shows the sheet. The meal for the time on the <see cref="TimeProvider"/> is selected each time it opens.</summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>The clock that picks the meal, in place of the registered <see cref="TimeProvider"/>. Stories set it to show each guess.</summary>
    [Parameter]
    public TimeProvider? Clock { get; set; }

    /// <summary>Raised with the selected meal by Search foods.</summary>
    [Parameter]
    public EventCallback<Meal> OnSearch { get; set; }

    /// <summary>Raised with the selected meal by Scan barcode.</summary>
    [Parameter]
    public EventCallback<Meal> OnScan { get; set; }

    /// <summary>Raised by the scrim, Android back and Escape. The sheet stays open until <see cref="Open"/> is cleared.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>The foods usual for the chosen meal, up to 3, set after <see cref="OnMealChanged"/>. The section is hidden when null or empty (nothing logged, or the read failed).</summary>
    [Parameter]
    public IReadOnlyList<UsualFoodRow>? Usual { get; set; }

    /// <summary>What failed when a usual food could not be added, shown in the sheet. Nothing shows when null.</summary>
    [Parameter]
    public string? AddError { get; set; }

    /// <summary>Raised with the meal when the sheet opens (the one it guessed) and when another meal chip is chosen, so the owner can set <see cref="Usual"/> for it.</summary>
    [Parameter]
    public EventCallback<Meal> OnMealChanged { get; set; }

    /// <summary>Raised by a usual food's +. The owner adds it and clears <see cref="Open"/>.</summary>
    [Parameter]
    public EventCallback<UsualAddRequest> OnAddUsual { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var opening = Open && !wasOpen;
        wasOpen = Open;
        if (opening)
        {
            meal = MealWindows.MealFor(TimeOnly.FromDateTime((Clock ?? Time).GetLocalNow().DateTime));
            Log.Opened(Logger, meal);
            await OnMealChanged.InvokeAsync(meal);
        }
    }

    private Task PickMeal(Meal picked)
    {
        meal = picked;
        return OnMealChanged.InvokeAsync(picked);
    }

    private Task AddUsualAsync(UsualFoodRow row)
    {
        Log.Chose(Logger, AddSheetAction.AddUsual, meal);
        return OnAddUsual.InvokeAsync(new UsualAddRequest(row, meal));
    }

    private Task ChooseAsync(AddSheetAction action, EventCallback<Meal> callback)
    {
        Log.Chose(Logger, action, meal);
        return callback.InvokeAsync(meal);
    }

    private Task DismissAsync()
    {
        Log.Chose(Logger, AddSheetAction.Dismiss, meal);
        return OnClose.InvokeAsync();
    }
}
