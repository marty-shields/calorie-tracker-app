@using System.Diagnostics
@using Microsoft.Extensions.Logging
@using CalorieTracker.UI.Screens
@inject ILogger<StartupGate> Logger
@if (_state == State.Ready)
{
    @ChildContent
}
else
{
    <StartupView Failed="_state == State.Failed" OnRetry="InitializeAgainAsync" />
}

@code {
    private enum State { Loading, Ready, Failed }

    private State _state;

    /// <summary>Startup work run before the content shows: once, and again each time Try again is pressed after it failed.</summary>
    [Parameter, EditorRequired]
    public Func<Task> Initialize { get; set; } = () => Task.CompletedTask;

    /// <summary>Content shown once <see cref="Initialize"/> completes.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override Task OnInitializedAsync() => RunAsync();

    private Task InitializeAgainAsync()
    {
        _state = State.Loading;
        return RunAsync();
    }

    private async Task RunAsync()
    {
        var started = Stopwatch.GetTimestamp();
        try
        {
            await Initialize();
            _state = State.Ready;
            Log.Started(Logger, (long)Stopwatch.GetElapsedTime(started).TotalMilliseconds);
        }
        catch (Exception exception)
        {
            _state = State.Failed;
            Log.Failed(Logger, exception);
        }
    }
}
