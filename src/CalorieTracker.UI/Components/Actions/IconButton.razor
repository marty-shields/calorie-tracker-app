<button @ref="button"
        type="button"
        class="icon-btn @(Compact ? "compact" : null) @(Active && !chip ? "active" : null) @(filled ? "filled" : null) @(soft ? "soft" : null)"
        aria-label="@AriaLabel"
        disabled="@Disabled"
        aria-pressed="@(Pressed is { } on ? (on ? "true" : "false") : null)"
        data-testid="@TestId"
        @onclick="OnClick">
    <Icon Name="Icon" Tone="@(Muted && !chip ? IconTone.Muted : IconTone.Default)" Size="Size" />
</button>

@code {
    private bool filled => Style == IconButtonStyle.Filled;

    private bool soft => Style == IconButtonStyle.Soft;

    private bool chip => filled || soft;

    /// <summary>Icon to show.</summary>
    [Parameter, EditorRequired]
    public IconName Icon { get; set; }

    /// <summary>Accessible name of the button.</summary>
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = "";

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Shows the icon in the muted text colour.</summary>
    [Parameter]
    public bool Muted { get; set; }

    /// <summary>Makes the button a toggle: <c>aria-pressed</c> is true or false. Null (the default) leaves the attribute off.</summary>
    [Parameter]
    public bool? Pressed { get; set; }

    /// <summary>Marks the button as on, with a filled round background.</summary>
    [Parameter]
    public bool Active { get; set; }

    /// <summary>Shrinks the tap area to <c>--touch-target-compact</c> for dense rows.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Look of the button. <c>Filled</c> and <c>Soft</c> draw a round chip behind the icon and ignore <c>Active</c> and <c>Muted</c>.</summary>
    [Parameter]
    public IconButtonStyle Style { get; set; }

    /// <summary>Size of the icon.</summary>
    [Parameter]
    public IconSize Size { get; set; }

    /// <summary>Disables the button, which dims it and takes it out of the tab order. It stays in the layout.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Raised when the button is tapped.</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    private ElementReference button;

    /// <summary>Moves focus to the button.</summary>
    public ValueTask FocusAsync() => button.FocusAsync();
}
