<div class="field @(Invalid ? "invalid" : null)">
    <label class="box">
        <span class="visually-hidden">@Label</span>
        <input type="text"
               class="input"
               value="@Value"
               maxlength="@MaxLength"
               placeholder="@Placeholder"
               disabled="@Disabled"
               aria-invalid="@(Invalid ? "true" : null)"
               aria-describedby="@(Invalid ? messageId : null)"
               data-testid="@InputTestId"
               @oninput="OnInput" />
    </label>
    @if (Invalid)
    {
        <p class="message" id="@messageId" role="alert" data-testid="@($"{InputTestId}-error")" data-wrap-ok>@InvalidMessage</p>
    }
</div>

@code {
    private readonly string messageId = $"text-field-{Guid.NewGuid():N}";
    private bool Invalid => !string.IsNullOrEmpty(InvalidMessage);
    private string InputTestId => TestId ?? "text-field";

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");

    /// <summary>What the text is, e.g. Serving name. Names the field for screen readers and is not shown.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>The text.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Raised on every keystroke with the typed text.</summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Longest text the field takes, in characters. The phone's keyboard stops there; the parent still checks the text.</summary>
    [Parameter]
    public int MaxLength { get; set; } = 100;

    /// <summary>Hint shown while the field is empty.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Error shown under the field in the error tone and announced. Null or empty means the field is valid.</summary>
    [Parameter]
    public string? InvalidMessage { get; set; }

    /// <summary>Greys out the input.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Value of the data-testid attribute on the input. The message adds -error.</summary>
    [Parameter]
    public string? TestId { get; set; }
}
