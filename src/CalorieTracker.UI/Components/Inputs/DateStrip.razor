@using System.Globalization
<div class="strip" data-testid="@Id">
    <IconButton Icon="IconName.ChevronLeft" AriaLabel="Previous day" TestId="@($"{Id}-previous")" OnClick="OnPrevious" />
    <button type="button"
            class="label"
            aria-label="@($"{LabelText}, go to today")"
            data-testid="@($"{Id}-label")"
            @onclick="OnToday">
        @LabelText
    </button>
    <IconButton Icon="IconName.Chevron" AriaLabel="Next day" TestId="@($"{Id}-next")" OnClick="OnNext" />
</div>

@code {
    private string Id => TestId ?? "date-strip";

    // The year is shown only for a date outside today's year.
    private string LabelText
    {
        get
        {
            var format = Date.Year == Today.Year ? "d MMM" : "d MMM yyyy";
            var date = Date.ToString(format, CultureInfo.InvariantCulture);
            return (Date.DayNumber - Today.DayNumber) switch
            {
                0 => $"Today, {date}",
                -1 => $"Yesterday, {date}",
                1 => $"Tomorrow, {date}",
                _ => $"{Date.ToString("ddd", CultureInfo.InvariantCulture)}, {date}",
            };
        }
    }

    /// <summary>Day shown. Any date is allowed; there is no limit either way.</summary>
    [Parameter, EditorRequired]
    public DateOnly Date { get; set; }

    /// <summary>The current day, given by the caller so the strip never reads the clock. Decides Today, Yesterday and Tomorrow.</summary>
    [Parameter, EditorRequired]
    public DateOnly Today { get; set; }

    /// <summary>Raised when the previous-day button is tapped.</summary>
    [Parameter]
    public EventCallback OnPrevious { get; set; }

    /// <summary>Raised when the next-day button is tapped.</summary>
    [Parameter]
    public EventCallback OnNext { get; set; }

    /// <summary>Raised when the label is tapped, from any day. The parent shows <see cref="Today"/>.</summary>
    [Parameter]
    public EventCallback OnToday { get; set; }

    /// <summary>Prefix of the data-testid attributes: the strip, and its <c>-previous</c>, <c>-label</c> and <c>-next</c> buttons. Defaults to date-strip.</summary>
    [Parameter]
    public string? TestId { get; set; }
}
