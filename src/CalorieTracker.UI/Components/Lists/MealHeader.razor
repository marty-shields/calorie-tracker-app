@using System.Globalization
<div class="meal-header" data-testid="@TestId">
    <h2 class="main">
        @if (OnToggle.HasDelegate)
        {
            <button type="button" class="toggle" aria-expanded="@(Expanded ? "true" : "false")" data-testid="@($"{TestId}-toggle")" @onclick="OnToggle">
                @Content
                <Icon Name="@(Expanded ? IconName.Up : IconName.Down)" Tone="IconTone.Muted" />
            </button>
        }
        else
        {
            <span class="toggle plain">@Content</span>
        }
    </h2>
    <IconButton Style="IconButtonStyle.Filled" Icon="IconName.Plus" AriaLabel="@($"Add to {Name}")" TestId="@($"{TestId}-add")" OnClick="OnAdd" />
</div>

@code {
    private RenderFragment Content => @<text>
        <span class="name" data-testid="@($"{TestId}-name")" data-wrap-ok>@Name</span>
        @if (Now)
        {
            <span class="chip" data-testid="@($"{TestId}-now")">Now</span>
        }
        @if (Hint is not null)
        {
            <span class="hint" data-testid="@($"{TestId}-hint")">@Hint</span>
        }
        <span class="spacer"></span>
        @if (Summary is not null)
        {
            <span class="summary" data-testid="@($"{TestId}-summary")">@Summary</span>
        }
        else if (Calories is not null)
        {
            <span class="calories" data-testid="@($"{TestId}-calories")">@Calories.Value.ToString("N0", CultureInfo.InvariantCulture) kcal</span>
        }
    </text>;

    /// <summary>Meal name, such as Lunch. The add button is labelled "Add to" and this.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    /// <summary>Total energy of the meal's entries, in kcal. Null (an empty meal) shows no total.</summary>
    [Parameter]
    public int? Calories { get; set; }

    /// <summary>A "Now" chip after the name: the meal's time window is open.</summary>
    [Parameter]
    public bool Now { get; set; }

    /// <summary>Muted text after the name, such as "from 11:00". Null shows none.</summary>
    [Parameter]
    public string? Hint { get; set; }

    /// <summary>One line in place of <see cref="Calories"/>, such as "3 items · 348 kcal", for a meal folded to its header.</summary>
    [Parameter]
    public string? Summary { get; set; }

    /// <summary>Whether the meal below is open. Sets <c>aria-expanded</c> and the arrow; only used when <see cref="OnToggle"/> is set.</summary>
    [Parameter]
    public bool Expanded { get; set; }

    /// <summary>Raised when the header is tapped. The header is a button with <c>aria-expanded</c> when set, and plain text when not.</summary>
    [Parameter]
    public EventCallback OnToggle { get; set; }

    /// <summary>Raised when the add button is tapped.</summary>
    [Parameter]
    public EventCallback OnAdd { get; set; }

    /// <summary>Prefix of the data-testid attributes: the header itself, then <c>-name</c>, <c>-calories</c>, <c>-summary</c>, <c>-now</c>, <c>-hint</c>, <c>-toggle</c> and <c>-add</c>.</summary>
    [Parameter]
    public string? TestId { get; set; }
}
