@using System.Globalization
<div class="share" role="img" aria-label="@Description" data-testid="@TestId">
    <div class="track" aria-hidden="true">
        @if (TotalKcal > 0)
        {
            <span class="segment protein" style="flex-grow: @Grow(ProteinKcal)" data-testid="@Id("protein-segment")"></span>
            <span class="segment carbs" style="flex-grow: @Grow(CarbsKcal)" data-testid="@Id("carbs-segment")"></span>
            <span class="segment fat" style="flex-grow: @Grow(FatKcal)" data-testid="@Id("fat-segment")"></span>
        }
    </div>
    <div class="labels" aria-hidden="true">
        <span class="label protein" data-testid="@Id("protein")">Protein <strong>@Grams(Protein) g</strong></span>
        <span class="label carbs" data-testid="@Id("carbs")">Carbs <strong>@Grams(Carbs) g</strong></span>
        <span class="label fat" data-testid="@Id("fat")">Fat <strong>@Grams(Fat) g</strong></span>
    </div>
</div>

@code {
    private const double KcalPerGramProtein = 4;
    private const double KcalPerGramCarbs = 4;
    private const double KcalPerGramFat = 9;

    /// <summary>Grams eaten. Counts 4 kcal per gram toward the bar.</summary>
    [Parameter]
    public double Protein { get; set; }

    /// <summary>Grams eaten. Counts 4 kcal per gram toward the bar.</summary>
    [Parameter]
    public double Carbs { get; set; }

    /// <summary>Grams eaten. Counts 9 kcal per gram toward the bar.</summary>
    [Parameter]
    public double Fat { get; set; }

    /// <summary>Value of the data-testid attribute, and the prefix of <c>{TestId}-protein</c>, <c>-carbs</c>, <c>-fat</c> and the <c>-segment</c> variants.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private double ProteinKcal => Math.Max(Protein, 0) * KcalPerGramProtein;

    private double CarbsKcal => Math.Max(Carbs, 0) * KcalPerGramCarbs;

    private double FatKcal => Math.Max(Fat, 0) * KcalPerGramFat;

    private double TotalKcal => ProteinKcal + CarbsKcal + FatKcal;

    private int Percent(double kcal) => (int)Math.Round(kcal / TotalKcal * 100, MidpointRounding.AwayFromZero);

    private string Description => TotalKcal > 0
        ? $"Energy share: protein {Grams(Protein)} g, {Percent(ProteinKcal)}% of calories; carbs {Grams(Carbs)} g, {Percent(CarbsKcal)}%; fat {Grams(Fat)} g, {Percent(FatKcal)}%."
        : "Energy share: protein 0 g, carbs 0 g, fat 0 g. Nothing eaten yet.";

    private static string Grow(double kcal) => kcal.ToString("0.###", CultureInfo.InvariantCulture);

    private static string Grams(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private string Id(string part) => $"{TestId}-{part}";
}
