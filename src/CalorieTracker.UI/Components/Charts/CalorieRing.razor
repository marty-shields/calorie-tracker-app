@using System.Globalization
<div class="ring @(State == RingState.Over ? "over" : null) @(Compact ? "compact" : null)" role="img" aria-label="@Description" data-testid="@TestId" style="--fill: @Fill">
    <span class="arc" aria-hidden="true"></span>
    <span class="centre" aria-hidden="true">
        <span class="value @Width" data-testid="@Id("value")">@Number(Shown)</span>
        <span class="unit" data-testid="@Id("label")">kcal @Word</span>
    </span>
</div>

@code {
    private enum RingState { NoTarget, Left, Over }

    /// <summary>Calories eaten, in kcal.</summary>
    [Parameter]
    public double Eaten { get; set; }

    /// <summary>Daily target in kcal. Null or zero means no target: the ring shows calories eaten.</summary>
    [Parameter]
    public int? Target { get; set; }

    /// <summary>The smaller ring (<c>--ring-size-compact</c>) that sits beside the figures in a summary card.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Value of the data-testid attribute, and the prefix of <c>{TestId}-value</c> and <c>-label</c>.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private int EatenKcal => (int)Math.Round(Math.Max(Eaten, 0), MidpointRounding.AwayFromZero);

    private int? TargetKcal => Target is > 0 ? Target : null;

    private RingState State => TargetKcal is not { } target ? RingState.NoTarget : EatenKcal > target ? RingState.Over : RingState.Left;

    private int Shown => TargetKcal is { } target ? Math.Abs(target - EatenKcal) : EatenKcal;

    /// <summary>Steps the number's size down as it gets wider, counting its commas: 6 characters ("12,345") is wider, 7 or more ("123,456") is widest; shorter numbers keep the base size.</summary>
    private string? Width => Number(Shown).Length switch { >= 7 => "widest", 6 => "wider", _ => null };

    private string Word => State switch { RingState.Left => "left", RingState.Over => "over", _ => "eaten" };

    /// <summary>Share of the ring that is filled, 0 to 1. With no target the ring is full once anything is eaten.</summary>
    private string Fill => (TargetKcal is { } target ? Math.Clamp((double)EatenKcal / target, 0, 1) : EatenKcal > 0 ? 1 : 0)
        .ToString("0.####", CultureInfo.InvariantCulture);

    private string Description => TargetKcal is { } target
        ? $"{Number(Shown)} kcal {Word}. Eaten {Number(EatenKcal)} of {Number(target)} kcal target."
        : $"{Number(Shown)} kcal eaten. No target set.";

    private string Id(string part) => $"{TestId}-{part}";

    private static string Number(int value) => value.ToString("N0", CultureInfo.InvariantCulture);
}
