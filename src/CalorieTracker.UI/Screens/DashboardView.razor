@using System.Globalization
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Diary
@using CalorieTracker.Core.Summary
<NavScreen Title="Calorie Tracker" Destination="NavDestination.Today" OnNavigate="OnNavigate" OnAdd="OpenSheet" Status="Notice">
    <Actions>
        <IconButton Icon="IconName.Settings" AriaLabel="Settings" TestId="settings" OnClick="OnSettings" />
    </Actions>
    <ChildContent>
        <div class="body">
            <DateStrip Date="Date" Today="Today" OnPrevious="OnPrevious" OnNext="OnNext" OnToday="OnToday" />
            @if (LoadFailed)
            {
                <LoadFailed Message="Couldn't load this day" TestId="dashboard-load-failed" OnRetry="OnRetry" />
            }
            else if (Loading || Summary is not { } summary)
            {
                <div class="centre">
                    <Spinner Label="Loading…" TestId="dashboard-loading" />
                </div>
            }
            else
            {
                var logged = summary.Meals.Any(m => m.Entries.Count > 0);
                <Card TestId="dashboard-card">
                    <div class="summary">
                        <div class="ring-row">
                            @{
                                var ringTarget = TargetOf(summary);
                                var eaten = Math.Max(summary.Totals.Kcal, 0);
                                var ringShown = ringTarget is { } limit ? Math.Abs(limit - eaten) : eaten;
                                var ringWord = RingWord(eaten, ringTarget);
                            }
                            <ProgressRing Compact Value="eaten" Max="ringTarget ?? 0" Figure="@Number(ringShown)" FigureUnit="@($"kcal {ringWord}")" AriaLabel="@RingLabel(eaten, ringTarget, ringShown, ringWord)" TestId="dashboard-ring" />
                            <div class="figures">
                                <Typography Variant="TextVariant.Muted" As="TextElement.P">Eaten <Typography Variant="TextVariant.Strong" TestId="dashboard-eaten">@Number(eaten)</Typography></Typography>
                                @if (summary.TargetKcal is { } target)
                                {
                                    <Typography Variant="TextVariant.Muted" As="TextElement.P">Target <Typography Variant="TextVariant.Strong" TestId="dashboard-target">@Number(target)</Typography></Typography>
                                }
                                else
                                {
                                    <Typography Variant="TextVariant.Muted" As="TextElement.P" TestId="dashboard-no-target" data-wrap-ok>No target set</Typography>
                                    <AppButton Variant="ButtonVariant.Secondary" TestId="dashboard-set-target" OnClick="OnSettings">Set a target</AppButton>
                                }
                            </div>
                        </div>
                        @if (logged)
                        {
                            <StackedBar Label="Energy share" Segments="MacroSegments.Of(summary.Totals.ProteinG, summary.Totals.CarbsG, summary.Totals.FatG)" TestId="dashboard-share" />
                        }
                    </div>
                </Card>
                @if (!logged)
                {
                    <EmptyState Message="@(Date == Today ? "Nothing logged today" : "Nothing logged this day")" Hint="Tap + on a meal to add your first food." TestId="dashboard-empty" />
                }
                @foreach (var meal in summary.Meals)
                {
                    var id = $"meal-{meal.Meal.ToString().ToLowerInvariant()}";
                    var isFolded = folded.Contains(meal.Meal);
                    var count = meal.Entries.Count;
                    <section class="meal" data-testid="@($"{id}-section")">
                        <div class="meal-head">
                            <SectionHeader Title="@meal.Meal.ToString()"
                                           Hint="@(isFolded ? FoldedSummary(meal) : null)"
                                           Total="@MealTotal(meal, isFolded)"
                                           Expanded="!isFolded"
                                           ExpandedChanged="@(EventCallback.Factory.Create<bool>(this, (bool _) => Toggle(meal.Meal)))"
                                           ControlsId="@($"{id}-entries")"
                                           TestId="@id" />
                            <IconButton Style="IconButtonStyle.Filled" Icon="IconName.Plus" AriaLabel="@($"Add to {meal.Meal}")" TestId="@($"{id}-add")" OnClick="@(() => OnAdd.InvokeAsync(new MealAddRequest(meal.Meal, Date)))" />
                        </div>
                        @if (!isFolded)
                        {
                            <div id="@($"{id}-entries")">
                                @if (count > 0)
                                {
                                    <ul class="entries">
                                        @foreach (var entry in meal.Entries)
                                        {
                                            <li><ListRow Text="@entry.Display.Title" Detail="@EntryDetail(entry)" Aside="@Number(entry.Nutrition.Kcal)" TestId="@($"entry-{entry.EntryId}")" OnClick="@EditTap(entry, meal.Meal)" /></li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="none"><Typography Variant="TextVariant.Muted" As="TextElement.P" TestId="@($"{id}-none")">Nothing logged</Typography></div>
                                }
                            </div>
                        }
                    </section>
                }
            }
        </div>
        <AddSheetHost Open="sheetOpen" Date="Date" OnClose="CloseSheet" Usual="UsualFoods" AddError="@UsualAddError" OnMealChanged="OnMealChanged" OnAddUsual="AddUsualAsync" OnSearch="OnAdd" OnScan="OnScan" />
    </ChildContent>
</NavScreen>

@code {
    private RenderFragment Notice => @<Snackbar />;

    private bool sheetOpen;

    /// <summary>The meals the person folded on the day shown. Every meal starts open; nothing is stored, so another day or a new route opens them all again.</summary>
    private readonly HashSet<Meal> folded = [];
    private DateOnly? shownDate;
    private Meal? shownFoldedMeal;

    protected override void OnParametersSet()
    {
        if (shownDate != Date)
        {
            shownDate = Date;
            folded.Clear();
            shownFoldedMeal = null;
        }

        if (FoldedMeal != shownFoldedMeal)
        {
            if (shownFoldedMeal is { } previous)
            {
                folded.Remove(previous);
            }

            shownFoldedMeal = FoldedMeal;
            if (FoldedMeal is { } meal)
            {
                folded.Add(meal);
            }
        }
    }

    private void Toggle(Meal meal)
    {
        if (!folded.Remove(meal))
        {
            folded.Add(meal);
        }
    }

    /// <summary>"3 items · 348 kcal", or "Nothing logged" for an empty meal.</summary>
    private static string FoldedSummary(MealSummary meal) =>
        meal.Entries.Count == 0 ? "Nothing logged" : $"{meal.Entries.Count} {(meal.Entries.Count == 1 ? "item" : "items")} · {Number(meal.Totals.Kcal)} kcal";

    /// <summary>The meal's energy on its own once it has entries and is open, else null.</summary>
    private static string? MealTotal(MealSummary meal, bool folded) =>
        !folded && meal.Entries.Count > 0 ? $"{Number(meal.Totals.Kcal)} kcal" : null;

    private void OpenSheet() => sheetOpen = true;

    private void CloseSheet() => sheetOpen = false;

    /// <summary>Adds the usual food to the day on the date strip and leaves its meal open unless it failed.</summary>
    private async Task<bool> AddUsualAsync(UsualAddRequest request, DateOnly day)
    {
        if (OnAddUsual is not { } add || !await add(request, day))
        {
            return false;
        }

        folded.Remove(request.Meal);
        return true;
    }

    /// <summary>The row's tap, or none when nothing handles <see cref="OnEdit"/>, so the row isn't tappable.</summary>
    private EventCallback EditTap(SummaryEntry entry, Meal meal) =>
        OnEdit.HasDelegate ? EventCallback.Factory.Create(this, () => OnEdit.InvokeAsync(new EntryEditRequest(entry, meal, Date))) : default;

    /// <summary>The day on the date strip.</summary>
    [Parameter]
    public DateOnly Date { get; set; }

    /// <summary>Today, for the date strip's labels.</summary>
    [Parameter]
    public DateOnly Today { get; set; }

    /// <summary>A meal to show folded, as if the person had tapped its header; the stories use it. Applied when its value changes, and forgotten when <see cref="Date"/> changes.</summary>
    [Parameter]
    public Meal? FoldedMeal { get; set; }

    /// <summary>The day's summary. The day is not shown until it is set, or <see cref="LoadFailed"/> is.</summary>
    [Parameter]
    public DaySummary? Summary { get; set; }

    /// <summary>The day is being read.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>The day could not be read, whatever the reason.</summary>
    [Parameter]
    public bool LoadFailed { get; set; }

    /// <summary>Raised by the date strip's previous arrow.</summary>
    [Parameter]
    public EventCallback OnPrevious { get; set; }

    /// <summary>Raised by the date strip's next arrow.</summary>
    [Parameter]
    public EventCallback OnNext { get; set; }

    /// <summary>Raised by the date strip's label, to return to today.</summary>
    [Parameter]
    public EventCallback OnToday { get; set; }

    /// <summary>Raised by a meal's + and by the Add sheet's Search foods (with the meal chosen there), each with the day on the date strip.</summary>
    [Parameter]
    public EventCallback<MealAddRequest> OnAdd { get; set; }

    /// <summary>Raised by the Add sheet's Scan barcode, with the meal chosen there and the day on the date strip.</summary>
    [Parameter]
    public EventCallback<MealAddRequest> OnScan { get; set; }

    /// <summary>The Add sheet's usual foods for the meal chosen there. None hides the section.</summary>
    [Parameter]
    public IReadOnlyList<UsualFoodRow>? UsualFoods { get; set; }

    /// <summary>What failed when a usual food could not be added; shown in the open sheet.</summary>
    [Parameter]
    public string? UsualAddError { get; set; }

    /// <summary>Raised with the meal when the Add sheet opens and when another meal is chosen there, so the usual foods can be read for it.</summary>
    [Parameter]
    public EventCallback<Meal> OnMealChanged { get; set; }

    /// <summary>Adds a usual food (the request) to the day (the second value) and returns true when it was added, so the sheet closes. Plain delegate, since the sheet needs the result. The + does nothing when unset.</summary>
    [Parameter]
    public Func<UsualAddRequest, DateOnly, Task<bool>>? OnAddUsual { get; set; }

    /// <summary>Raised by a tapped entry, to change or remove it.</summary>
    [Parameter]
    public EventCallback<EntryEditRequest> OnEdit { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    /// <summary>Raised by the Settings gear and by Set a target.</summary>
    [Parameter]
    public EventCallback OnSettings { get; set; }

    private static string Number(int value) => value.ToString("N0", CultureInfo.InvariantCulture);

    /// <summary>The day's target, or null when none is set (null or zero).</summary>
    private static int? TargetOf(DaySummary summary) => summary.TargetKcal is > 0 ? summary.TargetKcal : null;

    private static string RingWord(int eaten, int? target) => target is not { } goal ? "eaten" : eaten > goal ? "over" : "left";

    private static string RingLabel(int eaten, int? target, int shown, string word) => target is { } goal
        ? $"{Number(shown)} kcal {word}. Eaten {Number(eaten)} of {Number(goal)} kcal target."
        : $"{Number(shown)} kcal eaten. No target set.";

    /// <summary>The amount text after the brand line when the food has one.</summary>
    private static string EntryDetail(SummaryEntry entry) =>
        Prefixed(entry.Display.BrandLine, AmountText.Of(entry.Amount, entry.Unit, entry.Servings, entry.ServingLabel));

    private static string Prefixed(string? brand, string text) => brand is null ? text : $"{brand} · {text}";
}
