@using CalorieTracker.UI.Components.Feedback
@using CalorieTracker.UI.Components.Lists
@using CalorieTracker.UI.Models.Scan
<AppScreen Title="Scan barcode" Destination="NavDestination.Scan" OnNavigate="OnNavigate">
    <ChildContent>
        @switch (State)
        {
            case ScanState.OpeningCamera:
                <div class="centre">
                    <Spinner Label="Opening camera…" TestId="scan-opening-camera" />
                </div>
                break;
            case ScanState.LookingUp:
                <div class="centre">
                    <Spinner Label="Looking up product…" TestId="scan-looking-up" />
                </div>
                break;
            case ScanState.Found when Product is { } product:
                <div data-testid="scan-product">
                    <FoodValues Name="@product.Name" Brand="@product.Brand" IsLiquid="product.IsLiquid" Kcal="(double)product.Kcal" Protein="(double)product.Protein"
                                Carbs="(double)product.Carbs" Fat="(double)product.Fat" Fibre="(double?)product.Fibre" Sugars="(double?)product.Sugars"
                                Saturates="(double?)product.Saturates" Salt="(double?)product.Salt" TestId="scan">
                        @if (product.KcalMismatch)
                        {
                            <p class="warning" role="alert" data-testid="scan-warning" data-wrap-ok>These values don't add up. Check the label before relying on them.</p>
                        }
                    </FoodValues>
                </div>
                break;
            case ScanState.CameraUnavailable:
                <LoadFailed Message="Couldn't open the camera" TestId="scan-camera-unavailable" OnRetry="OnScanAgain" />
                break;
            default:
                <EmptyState Message="Unable to find this product" TestId="scan-not-found" />
                break;
        }
    </ChildContent>
    <BottomBar>
        @if (State is ScanState.Found or ScanState.NotFound)
        {
            <AppButton FullWidth TestId="scan-again" OnClick="OnScanAgain">Scan again</AppButton>
        }
    </BottomBar>
</AppScreen>

@code {
    /// <summary>Which state to show.</summary>
    [Parameter]
    public ScanState State { get; set; }

    /// <summary>The product to show when <see cref="State"/> is Found. Found with null shows the not-found message.</summary>
    [Parameter]
    public ScannedProduct? Product { get; set; }

    /// <summary>Raised by Scan again, and by Try again when the camera could not open.</summary>
    [Parameter]
    public EventCallback OnScanAgain { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, or with the start screen on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }
}
