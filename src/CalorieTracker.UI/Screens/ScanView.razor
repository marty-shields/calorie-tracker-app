@using CalorieTracker.Core.Data
@using CalorieTracker.UI.Components.Lists
@using CalorieTracker.UI.Models.Scan
@using CalorieTracker.UI.Scanning
<AppScreen Title="Scan barcode" OnBack="OnBack">
    <div class="scan">
        <p class="adding" data-testid="scan-adding">@ScanCaption.For(Meal, Date)</p>
        @switch (State)
        {
            case ScanState.OpeningCamera:
                <div class="centre">
                    <Spinner Label="Opening camera…" TestId="scan-opening-camera" />
                </div>
                break;
            case ScanState.Closing:
                <div class="centre">
                    <Spinner Label="Closing camera…" TestId="scan-closing-camera" />
                </div>
                break;
            case ScanState.LookingUp:
                <div class="centre">
                    <Spinner Label="Looking up product…" TestId="scan-looking-up" />
                </div>
                break;
            case ScanState.CameraUnavailable:
                <div class="centre">
                    <LoadFailed Message="Couldn't open the camera" TestId="scan-camera-unavailable" OnRetry="OnScanAgain" />
                    <AppButton Variant="ButtonVariant.Secondary" FullWidth TestId="scan-search" OnClick="OnSearchByName">Search by name instead</AppButton>
                </div>
                break;
            default:
                <div class="centre">
                    <EmptyState Message="Unable to find this product" Hint="Try another barcode, or search by name." TestId="scan-not-found" />
                    <div class="actions">
                        <AppButton FullWidth TestId="scan-search" OnClick="OnSearchByName">Search by name instead</AppButton>
                        <AppButton FullWidth Variant="ButtonVariant.Secondary" TestId="scan-again" OnClick="OnScanAgain">Scan again</AppButton>
                    </div>
                </div>
                break;
        }
    </div>
</AppScreen>

@code {
    /// <summary>Which state to show. A found product has no state: the page hands it on to Serving at once.</summary>
    [Parameter]
    public ScanState State { get; set; }

    /// <summary>The meal being added to, shown in the chip.</summary>
    [Parameter]
    public Meal Meal { get; set; }

    /// <summary>The day being added to, shown in the chip as day and month.</summary>
    [Parameter]
    public DateOnly Date { get; set; }

    /// <summary>Raised by Search by name instead, shown when nothing was found or the camera could not open.</summary>
    [Parameter]
    public EventCallback OnSearchByName { get; set; }

    /// <summary>Raised by Scan again, and by Try again when the camera could not open.</summary>
    [Parameter]
    public EventCallback OnScanAgain { get; set; }

    /// <summary>Raised by the back arrow and Android back.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }
}
