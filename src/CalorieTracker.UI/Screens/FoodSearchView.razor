@using System.Globalization
@using Microsoft.JSInterop
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Foods
@using CalorieTracker.Core.History
@using CalorieTracker.Core.Summary
@using Shields.UI.Components.Feedback
@using CalorieTracker.UI.Components.Inputs
@using CalorieTracker.UI.Components.Lists
@using CalorieTracker.UI.Models.Search
<AppScreen Title="@($"Add to {Meal}")" Subtitle="@(Date is { } day ? DayLabel.For(day, Today) : null)" OnBack="OnBack" Toolbar="@(!Failed ? Tools : null)" BottomBar="@(Pinned ? PinnedBar : null)">
    <ChildContent>
        @if (Loading)
        {
            <div class="loading">
                <Spinner Label="Loading foods…" TestId="food-search-loading" />
            </div>
        }
        else if (Failed)
        {
            <LoadFailed Message="Couldn't search foods" TestId="food-search" OnRetry="OnRetry" />
        }
        else if (string.IsNullOrWhiteSpace(Query) && Groups.Count == 0)
        {
            <EmptyState Message="Search for a food" Hint="Type a name, like oats or cheddar." TestId="food-search-idle" />
        }
        else if (Groups.Count == 0)
        {
            <div class="add-none">
                <EmptyState Message="No foods match" Hint="Try another word." TestId="food-search-none" />
            </div>

            @Online
        }
        else
        {
            <div class="groups" data-testid="food-results">
                @foreach (var group in Groups)
                {
                    var name = Key(group.Kind);
                    var open = Expanded.Contains(group.Kind);
                    var showsAll = open || group.Kind is FoodGroupKind.Usual or FoodGroupKind.Recent;
                    var hidden = showsAll ? 0 : Math.Max(0, group.Foods.Count - ShownLimit);
                    var shown = showsAll ? group.Foods.Count : Math.Min(group.Foods.Count, ShownLimit);
                    <section class="group">
                        <h2 class="group-heading" data-testid="@($"food-group-{name}")">@Heading(group.Kind)</h2>
                        <ul class="rows">
                            @foreach (var item in group.Foods.Take(shown))
                            {
                                <li>
                                    @{ var display = FoodDisplay.Of(item.Food); }
                                    <ListRow Text="@display.Title" Detail="@Subtitle(item, display)"
                                             OnClick="@(() => OnSelect.InvokeAsync(item.Food))" TestId="@($"food-result-{item.Food.Id}")" />
                                </li>
                            }
                            @if (hidden > 0)
                            {
                                <li>
                                    <ListRow Text="@($"Show {hidden} more")" OnClick="@(() => OnExpand.InvokeAsync(group.Kind))" TestId="@($"food-group-{name}-more")" />
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Query))
            {
                @Online
            }
        }
    </ChildContent>
</AppScreen>

@code {
    /// <summary>The text in the search box.</summary>
    [Parameter]
    public string Query { get; set; } = "";

    /// <summary>The lists to show, each under its heading, in the order given. With a query they are its matches, best first; with none, the foods to start from. The favourites group, typed or not, and a typed group (diary, common, branded) show <see cref="ShownLimit"/> foods and a "Show N more" row (N is the foods the group holds less those shown, so it is what the row reveals) for the rest; the usual and recent groups show all they hold. A favourite row looks like any other row, with no star marker.
    /// With no groups, an empty query shows "Search for a food" and a typed one "No foods match".</summary>
    [Parameter]
    public IReadOnlyList<FoodGroup> Groups { get; set; } = [];

    /// <summary>The groups already expanded to all their foods.</summary>
    [Parameter]
    public IReadOnlySet<FoodGroupKind> Expanded { get; set; } = new HashSet<FoodGroupKind>();

    /// <summary>Raised with the group whose "Show N more" row was tapped.</summary>
    [Parameter]
    public EventCallback<FoodGroupKind> OnExpand { get; set; }

    /// <summary>Where the online search is. Idle: "Search online" is pinned in the bottom bar while something is typed, never with the loading state or a load error. Any other state shows in the list under the local groups.</summary>
    [Parameter]
    public OnlineSearchState OnlineState { get; set; }

    /// <summary>The products found, shown as a group headed "Online · country" in <see cref="OnlineSearchState.Results"/> and <see cref="OnlineSearchState.Importing"/>, and under a busy, offline, failed or "can't be added" message after a product could not be fetched. A group shows <see cref="ShownLimit"/> products and a "Show N more" row for the rest.</summary>
    [Parameter]
    public IReadOnlyList<OnlineProduct> OnlineProducts { get; set; } = [];

    /// <summary>The country the search was limited to, as the group heading says it; null is "worldwide".</summary>
    [Parameter]
    public string? OnlineCountry { get; set; }

    /// <summary>The products group shows all it holds.</summary>
    [Parameter]
    public bool OnlineExpanded { get; set; }

    /// <summary>Shows the first-use notice ("This sends what you typed to an online database.") in the pinned bar above the search button.</summary>
    [Parameter]
    public bool OnlineNoticeVisible { get; set; }

    /// <summary>Raised by the "Search online" button: the tap that sends the typed text.</summary>
    [Parameter]
    public EventCallback OnSearchOnline { get; set; }

    /// <summary>Raised with the product tapped in the online group.</summary>
    [Parameter]
    public EventCallback<OnlineProduct> OnSelectOnline { get; set; }

    /// <summary>Raised by the products group's "Show N more" row.</summary>
    [Parameter]
    public EventCallback OnExpandOnline { get; set; }

    /// <summary>Raised by Try again under a busy, offline or failed message.</summary>
    [Parameter]
    public EventCallback OnRetryOnline { get; set; }

    /// <summary>Shows a spinner while the food list is loaded for the first time, instead of the results.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Shows a load error with Try again instead of the results.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>The meal being added to: the title reads "Add to Lunch", a back arrow leaves for where search was opened and no navigation bar shows.</summary>
    [Parameter]
    public Meal Meal { get; set; }

    /// <summary>The day being added to, shown under the title such as "Today, 18 Nov". Null shows no day.</summary>
    [Parameter]
    public DateOnly? Date { get; set; }

    /// <summary>The current day, given by the caller so the view never reads the clock. Decides Today, Yesterday and Tomorrow in the day under the title.</summary>
    [Parameter]
    public DateOnly Today { get; set; }

    /// <summary>Raised with the whole text on every keystroke.</summary>
    [Parameter]
    public EventCallback<string> OnQueryChanged { get; set; }

    /// <summary>Raised with the food tapped in the results.</summary>
    [Parameter]
    public EventCallback<Food> OnSelect { get; set; }

    /// <summary>Raised by the back arrow and Android back.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Raised by the barcode button after the search field, which opens the scanner for the same meal and day.</summary>
    [Parameter]
    public EventCallback OnScan { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Whether the pinned "Search online" bar shows: text is typed, the list is not loading or failed, and the online search has not run for this text.</summary>
    private bool Pinned => !Loading && !Failed && !string.IsNullOrWhiteSpace(Query) && OnlineState == OnlineSearchState.Idle;

    /// <summary>The bar pinned at the foot of the screen: the first-use notice, if due, above the button. The button is primary when no stored food matched, secondary otherwise.</summary>
    private RenderFragment PinnedBar =>
        @<div class="pinned" data-testid="food-search-online-bar">
            @if (OnlineNoticeVisible)
            {
                <p class="online-notice" data-testid="food-search-online-notice">@OnlineSearchNotice.Text</p>
            }
            <AppButton Variant="@(Groups.Count == 0 ? ButtonVariant.Primary : ButtonVariant.Secondary)" FullWidth TestId="food-search-online" OnClick="SearchOnline">Search online</AppButton>
        </div>;

    /// <summary>The online part under the local results, once the search has run for the typed text; nothing before.</summary>
    private RenderFragment Online =>
        @<text>
            @if (OnlineState != OnlineSearchState.Idle)
            {
            <div @ref="onlineSection" class="online" tabindex="-1" data-testid="food-search-online-section">
                @switch (OnlineState)
                {
                    case OnlineSearchState.Searching:
                        <div class="loading">
                            <Spinner Label="Searching online…" TestId="food-search-online-loading" />
                        </div>
                        break;
                    case OnlineSearchState.Importing:
                        @OnlineGroup
                        <div class="loading">
                            <Spinner Label="Getting the product…" TestId="food-search-online-importing" />
                        </div>
                        break;
                    case OnlineSearchState.Results:
                        @OnlineGroup
                        break;
                    case OnlineSearchState.None:
                        <p class="none" data-testid="food-search-online-none">Nothing found online</p>
                        break;
                    case OnlineSearchState.Unavailable:
                        <p class="none" data-testid="food-search-online-unavailable">That product can't be added</p>
                        @OnlineGroup
                        break;
                    default:
                        <LoadFailed Message="@OnlineMessage" TestId="food-search-online" OnRetry="OnRetryOnline" />
                        @OnlineGroup
                        break;
                }
            </div>
            }
        </text>;

    private string OnlineMessage => OnlineState switch
    {
        OnlineSearchState.Busy => "The online search is busy. Try again in a minute.",
        OnlineSearchState.Offline => "You are offline",
        _ => "Couldn't reach the online search",
    };

    private RenderFragment OnlineGroup =>
        @<text>
            @if (OnlineProducts.Count > 0)
            {
                var hidden = OnlineExpanded ? 0 : Math.Max(0, OnlineProducts.Count - ShownLimit);
                var shown = OnlineProducts.Count - hidden;
                <section class="group">
                    <h2 class="group-heading" data-testid="food-group-online">Online · @(OnlineCountry ?? "worldwide")</h2>
                    <ul class="rows">
                        @foreach (var product in OnlineProducts.Take(shown))
                        {
                            var display = FoodDisplay.Of(product.Food);
                            <li>
                                <ListRow Text="@display.Title" Detail="@Subtitle(new FoodListing(product.Food, null), display)" Aside="@(product.IsNew ? "NEW" : null)"
                                         OnClick="@(() => OnSelectOnline.InvokeAsync(product))" TestId="@($"food-online-{product.Barcode}")" />
                            </li>
                        }
                        @if (hidden > 0)
                        {
                            <li>
                                <ListRow Text="@($"Show {hidden} more")" OnClick="OnExpandOnline" TestId="food-group-online-more" />
                            </li>
                        }
                    </ul>
                </section>
            }
        </text>;

    private RenderFragment Tools =>
        @<div class="tools">
            <div class="search">
                <span class="search-icon"><Icon Name="IconName.Search" Tone="IconTone.Muted" /></span>
                <input type="search" class="search-input" placeholder="Search foods" aria-label="Search foods" autocomplete="off" enterkeyhint="search"
                       value="@Query" data-testid="food-search-input" @oninput="OnInput" @onkeydown="OnKeyDown" />
                <span class="search-divider" aria-hidden="true"></span>
                <span class="search-scan">
                    <IconButton Icon="IconName.Scan" AriaLabel="Scan a barcode" Compact TestId="search-scan" OnClick="OnScan" />
                </span>
            </div>
        </div>;

    /// <summary>The search key of the keyboard is a tap on "Search online" once something is typed.</summary>
    private Task OnKeyDown(KeyboardEventArgs args) =>
        args.Key == "Enter" && !Loading && !string.IsNullOrWhiteSpace(Query) ? SearchOnline() : Task.CompletedTask;

    private ElementReference onlineSection;

    private bool focusOnline;

    /// <summary>Raises <see cref="OnSearchOnline"/>. The tapped button leaves with the bar, so focus moves to the online section once it shows.</summary>
    private Task SearchOnline()
    {
        focusOnline = true;
        return OnSearchOnline.InvokeAsync();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusOnline || OnlineState == OnlineSearchState.Idle)
        {
            return;
        }

        focusOnline = false;
        try
        {
            await onlineSection.FocusAsync();
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            // Focus is a courtesy; the results show either way.
        }
    }

    private Task OnInput(ChangeEventArgs args) => OnQueryChanged.InvokeAsync(args.Value?.ToString() ?? "");

    /// <summary>Foods a group shows before its "Show N more" row.</summary>
    public const int ShownLimit = 5;

    private static string Key(FoodGroupKind kind) => kind.ToString().ToLowerInvariant();

    private string Heading(FoodGroupKind kind) => kind switch
    {
        FoodGroupKind.Favourites => "Favourites",
        FoodGroupKind.Usual => $"Usual for {Meal.ToString().ToLowerInvariant()}",
        FoodGroupKind.Recent => "Recent",
        FoodGroupKind.Diary => "From your diary",
        FoodGroupKind.Common => "Common",
        _ => "Branded",
    };

    /// <summary>A food from the diary shows what was last had and its energy; any other shows the energy per 100 g or ml.</summary>
    private static string Subtitle(FoodListing item, FoodDisplay display)
    {
        var food = item.Food;
        var detail = display.Detail;
        var values = item.History is { } last
            ? $"{Last(last, food)} · {Number(Nutrition.ForAmount(food, last.LastAmount).Kcal)} kcal"
            : $"{Number(food.Kcal)} kcal / 100 {UnitText(food)}";
        return detail is null ? values : $"{detail} · {values}";
    }

    private static string Last(FoodHistory last, Food food) =>
        last.LastServings is { } servings
            ? $"{Number(servings)} {(servings == 1 ? "serving" : "servings")} ({Number(last.LastAmount)} {UnitText(food)})"
            : $"{Number(last.LastAmount)} {UnitText(food)}";

    private static string UnitText(Food food) => food.Unit == FoodUnit.Millilitre ? "ml" : "g";

    private static string Number(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
