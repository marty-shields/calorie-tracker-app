@using System.Globalization
@using CalorieTracker.Core.Data
@using CalorieTracker.UI.Components.Feedback
@using CalorieTracker.UI.Components.Lists
<AppScreen Title="Search foods" Destination="NavDestination.Foods" OnNavigate="OnNavigate" OnBack="@(Selected is null ? default : OnClearSelection)"
           Toolbar="@(Selected is null && !Failed ? Tools : null)">
    <ChildContent>
        @if (Selected is { } food)
        {
            <section class="detail" data-testid="food-detail">
                <FoodValues Name="@food.Name" Brand="@food.Brand" IsLiquid="@(food.Unit == FoodUnit.Millilitre)" Kcal="food.Kcal" Protein="food.ProteinG"
                            Carbs="food.CarbsG" Fat="food.FatG" Fibre="food.FibreG" Sugars="food.SugarsG" Saturates="food.SaturatesG" Salt="food.SaltG"
                            TestId="food-detail" />
                <AppButton Variant="ButtonVariant.Secondary" FullWidth TestId="food-detail-close" OnClick="OnClearSelection">Back to results</AppButton>
            </section>
        }
        else if (Loading)
        {
            <div class="loading">
                <Spinner Label="Loading foods…" TestId="food-search-loading" />
            </div>
        }
        else if (Failed)
        {
            <LoadFailed Message="Couldn't search foods" TestId="food-search" OnRetry="OnRetry" />
        }
        else if (string.IsNullOrWhiteSpace(Query))
        {
            <EmptyState Message="Search for a food" Hint="Type a name, like oats or cheddar." TestId="food-search-idle" />
        }
        else if (Results.Count == 0)
        {
            <p class="none" data-testid="food-search-none">No foods match</p>
        }
        else
        {
            <ul class="rows" data-testid="food-results">
                @foreach (var item in Results)
                {
                    <li>
                        <ListRow Text="@item.Name" Detail="@item.Brand" Aside="@($"{Number(item.Kcal)} kcal / 100 {UnitText(item)}")"
                                 OnClick="@(() => OnSelect.InvokeAsync(item))" TestId="@($"food-result-{item.Id}")" />
                    </li>
                }
            </ul>
        }
    </ChildContent>
</AppScreen>

@code {
    /// <summary>The text in the search box.</summary>
    [Parameter]
    public string Query { get; set; } = "";

    /// <summary>Foods matching <see cref="Query"/>, best match first. Empty shows "No foods match" once something is typed.</summary>
    [Parameter]
    public IReadOnlyList<Food> Results { get; set; } = [];

    /// <summary>The food whose values show in place of the list. Null shows the list.</summary>
    [Parameter]
    public Food? Selected { get; set; }

    /// <summary>Shows a spinner while the food list is loaded for the first time, instead of the results.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Shows a load error with Try again instead of the results.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>Raised with the whole text on every keystroke.</summary>
    [Parameter]
    public EventCallback<string> OnQueryChanged { get; set; }

    /// <summary>Raised with the food tapped in the results.</summary>
    [Parameter]
    public EventCallback<Food> OnSelect { get; set; }

    /// <summary>Raised by Back to results on a food's values, the back arrow and Android back.</summary>
    [Parameter]
    public EventCallback OnClearSelection { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, or with the start screen on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    private RenderFragment Tools =>
        @<div class="tools">
            <div class="search">
                <span class="search-icon"><Icon Name="IconName.Search" Tone="IconTone.Muted" /></span>
                <input type="search" class="search-input" placeholder="Search foods" aria-label="Search foods" autocomplete="off"
                       value="@Query" data-testid="food-search-input" @oninput="OnInput" />
            </div>
        </div>;

    private Task OnInput(ChangeEventArgs args) => OnQueryChanged.InvokeAsync(args.Value?.ToString() ?? "");

    private static string UnitText(Food food) => food.Unit == FoodUnit.Millilitre ? "ml" : "g";

    private static string Number(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
