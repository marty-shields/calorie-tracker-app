@using System.Globalization
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Foods
@using CalorieTracker.Core.History
@using CalorieTracker.UI.Components.Feedback
@using CalorieTracker.UI.Components.Inputs
@using CalorieTracker.UI.Components.Lists
@* AppScreen shows Status only with a navigation bar, and add mode has none. The snackbar there is shown by the Dashboard. *@
<AppScreen Title="@(Meal is { } meal ? $"Add to {meal}" : "Search foods")" Destination="@(Meal is null ? NavDestination.Foods : null)" OnNavigate="OnNavigate"
           OnBack="@(Meal is not null ? OnBack : Selected is null ? default : OnClearSelection)" Toolbar="@(Selected is null && !Failed ? Tools : null)"
           Status="@(Meal is null ? Notice : null)" BottomBar="@(Selected is { } chosen ? Actions(chosen) : null)">
    <ChildContent>
        @if (Selected is { } food)
        {
            var display = FoodDisplay.Of(food);
            <section class="detail" data-testid="food-detail">
                <FoodValues Name="@display.Title" Brand="@display.BrandLine" Pack="@display.Pack" GenericName="@display.GenericName" IsLiquid="@(food.Unit == FoodUnit.Millilitre)" Kcal="food.Kcal" Protein="food.ProteinG"
                            Carbs="food.CarbsG" Fat="food.FatG" Fibre="food.FibreG" Sugars="food.SugarsG" Saturates="food.SaturatesG" Salt="food.SaltG"
                            TestId="food-detail" />
            </section>
        }
        else if (Loading)
        {
            <div class="loading">
                <Spinner Label="Loading foods…" TestId="food-search-loading" />
            </div>
        }
        else if (Failed)
        {
            <LoadFailed Message="Couldn't search foods" TestId="food-search" OnRetry="OnRetry" />
        }
        else if (string.IsNullOrWhiteSpace(Query) && Groups.Count == 0)
        {
            <EmptyState Message="Search for a food" Hint="Type a name, like oats or cheddar." TestId="food-search-idle" />
        }
        else if (Groups.Count == 0)
        {
            @if (Meal is null)
            {
                <p class="none" data-testid="food-search-none">No foods match</p>
            }
            else
            {
                <div class="add-none">
                    <EmptyState Message="No foods match" Hint="Try another word." TestId="food-search-none" />
                </div>
            }
        }
        else
        {
            <div class="groups" data-testid="food-results">
                @foreach (var group in Groups)
                {
                    var name = Key(group.Kind);
                    var open = Expanded.Contains(group.Kind);
                    var showsAll = open || group.Kind is FoodGroupKind.Usual or FoodGroupKind.Recent;
                    var hidden = showsAll ? 0 : Math.Max(0, group.Foods.Count - ShownLimit);
                    var shown = showsAll ? group.Foods.Count : Math.Min(group.Foods.Count, ShownLimit);
                    <section class="group">
                        <h2 class="group-heading" data-testid="@($"food-group-{name}")">@Heading(group.Kind)</h2>
                        <ul class="rows">
                            @foreach (var item in group.Foods.Take(shown))
                            {
                                <li>
                                    <ListRow Text="@FoodDisplay.Of(item.Food).Title" Detail="@Subtitle(item)"
                                             OnClick="@(() => OnSelect.InvokeAsync(item.Food))" TestId="@($"food-result-{item.Food.Id}")" />
                                </li>
                            }
                            @if (hidden > 0)
                            {
                                <li>
                                    <ListRow Text="@($"Show {hidden} more")" OnClick="@(() => OnExpand.InvokeAsync(group.Kind))" TestId="@($"food-group-{name}-more")" />
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }
    </ChildContent>
</AppScreen>

@code {
    /// <summary>The text in the search box.</summary>
    [Parameter]
    public string Query { get; set; } = "";

    /// <summary>The lists to show, each under its heading, in the order given. With a query they are its matches, best first; with none, the foods to start from. A typed group (diary, common, branded) shows <see cref="ShownLimit"/> foods and a "Show N more" row (N is the foods the group holds less those shown, so it is what the row reveals) for the rest; the usual and recent groups show all they hold.
    /// With no groups, an empty query shows "Search for a food" and a typed one "No foods match".</summary>
    [Parameter]
    public IReadOnlyList<FoodGroup> Groups { get; set; } = [];

    /// <summary>The groups already expanded to all their foods.</summary>
    [Parameter]
    public IReadOnlySet<FoodGroupKind> Expanded { get; set; } = new HashSet<FoodGroupKind>();

    /// <summary>Raised with the group whose "Show N more" row was tapped.</summary>
    [Parameter]
    public EventCallback<FoodGroupKind> OnExpand { get; set; }

    /// <summary>The food whose values show in place of the list. Null shows the list.</summary>
    [Parameter]
    public Food? Selected { get; set; }

    /// <summary>Shows a spinner while the food list is loaded for the first time, instead of the results.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Shows a load error with Try again instead of the results.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>The meal being added to, which turns search into add mode: the title reads "Add to Lunch", a back arrow leaves for the Dashboard and no navigation bar shows. Null is the Foods tab.</summary>
    [Parameter]
    public Meal? Meal { get; set; }

    /// <summary>Raised with the whole text on every keystroke.</summary>
    [Parameter]
    public EventCallback<string> OnQueryChanged { get; set; }

    /// <summary>Raised with the food tapped in the results.</summary>
    [Parameter]
    public EventCallback<Food> OnSelect { get; set; }

    /// <summary>Raised with the food on a food's values by Add to diary.</summary>
    [Parameter]
    public EventCallback<Food> OnAdd { get; set; }

    /// <summary>Raised by the back arrow and Android back in add mode.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Raised by Back to results on a food's values, the back arrow and Android back.</summary>
    [Parameter]
    public EventCallback OnClearSelection { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, or with the start screen on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    private RenderFragment Actions(Food chosen) =>
        @<div class="actions">
            <AppButton Variant="ButtonVariant.Primary" FullWidth TestId="food-detail-add" OnClick="@(() => OnAdd.InvokeAsync(chosen))">Add to diary</AppButton>
            <AppButton Variant="ButtonVariant.Secondary" FullWidth TestId="food-detail-close" OnClick="OnClearSelection">Back to results</AppButton>
        </div>;

    private RenderFragment Notice => @<Snackbar />;

    private RenderFragment Tools =>
        @<div class="tools">
            <div class="search">
                <span class="search-icon"><Icon Name="IconName.Search" Tone="IconTone.Muted" /></span>
                <input type="search" class="search-input" placeholder="Search foods" aria-label="Search foods" autocomplete="off"
                       value="@Query" data-testid="food-search-input" @oninput="OnInput" />
            </div>
        </div>;

    private Task OnInput(ChangeEventArgs args) => OnQueryChanged.InvokeAsync(args.Value?.ToString() ?? "");

    /// <summary>Foods a group shows before its "Show N more" row.</summary>
    public const int ShownLimit = 5;

    private static string Key(FoodGroupKind kind) => kind.ToString().ToLowerInvariant();

    private string Heading(FoodGroupKind kind) => kind switch
    {
        FoodGroupKind.Usual => $"Usual for {(Meal?.ToString() ?? "meal").ToLowerInvariant()}",
        FoodGroupKind.Recent => "Recent",
        FoodGroupKind.Diary => "From your diary",
        FoodGroupKind.Common => "Common",
        _ => "Branded",
    };

    /// <summary>A food from the diary shows what was last had and its energy; any other shows the energy per 100 g or ml.</summary>
    private static string Subtitle(FoodListing item)
    {
        var food = item.Food;
        var detail = FoodDisplay.Of(food).Detail;
        var values = item.History is { } last
            ? $"{Last(last, food)} · {Number(Math.Round(food.Kcal * last.LastAmount / 100))} kcal"
            : $"{Number(food.Kcal)} kcal / 100 {UnitText(food)}";
        return detail is null ? values : $"{detail} · {values}";
    }

    private static string Last(FoodHistory last, Food food) =>
        last.LastServings is { } servings
            ? $"{Number(servings)} {(servings == 1 ? "serving" : "servings")} ({Number(last.LastAmount)} {UnitText(food)})"
            : $"{Number(last.LastAmount)} {UnitText(food)}";

    private static string UnitText(Food food) => food.Unit == FoodUnit.Millilitre ? "ml" : "g";

    private static string Number(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
