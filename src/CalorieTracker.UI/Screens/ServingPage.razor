@using System.Globalization
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Diary
@using CalorieTracker.Core.Foods
@using CalorieTracker.UI.Components.Feedback
@using CalorieTracker.UI.Models.Serving
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject FoodService Foods
@inject ServingService ServingsApi
@inject DiaryService Diary
@inject TimeProvider Time
@inject SnackbarService Snackbar
@inject FavouriteService Favourites
@inject ILogger<ServingPage> Logger

<ServingView Favourite="star.IsFavourite" OnToggleFavourite="star.ToggleAsync" Food="food" Servings="offered" ServingId="chosen?.Id" OnServingChanged="ChangeServing"
             AddingOwn="addingOwn" OwnLabel="@ownLabel" OwnAmount="ownAmount" OwnError="@ownError" SavingOwn="savingOwn"
             OnOwnOpen="OpenOwn" OnOwnLabelChanged="ChangeOwnLabel" OnOwnAmountChanged="ChangeOwnAmount" OnOwnSave="SaveOwnAsync" OnOwnCancel="CancelOwn" OnDeleteOwn="DeleteOwnAsync"
             Loading="loading" LoadFailed="loadFailed" Mode="mode" Amount="amount" Grams="Grams" Meal="meal" SuggestedAt="suggestedAt"
             Saving="saving" Removing="removing" SaveFailed="saveFailed" Editing="Editing" Date="Date" RemoveFailed="removeFailed" EntryGone="entryGone" OnSave="SaveAsync" OnRemove="RemoveAsync" OnModeChanged="ChangeMode" OnAmountChanged="ChangeAmount" OnUseServing="UseServing"
             OnMealChanged="ChangeMeal" OnAdd="AddAsync" OnRetry="LoadAsync" OnBack="OnBack" />

@code {
    private FavouriteStar star = null!;
    private Food? food;
    private IReadOnlyList<Serving> offered = [];
    private Serving? chosen;

    /// <summary>True while an entry being edited points at no serving the food offers (none, or one since deleted): the screen opens in grams with the stored amount, and Save keeps the link empty until the person switches to servings and picks one, so the entry is not rewritten as a count of one it never used.</summary>
    private bool entryServingUnmatched;
    private bool addingOwn;
    private string? ownLabel;
    private decimal? ownAmount;
    private string? ownError;
    private bool savingOwn;
    private bool loading = true;
    private bool loadFailed;
    private EntryMode mode = EntryMode.Servings;
    private decimal? amount;

    /// <summary>Set when switching from grams to servings so the weight stays exactly as it was, until the amount is edited.</summary>
    private double? lockedGrams;
    private Meal meal;
    private TimeOnly? suggestedAt;
    private bool saving;
    private bool removing;
    private bool saveFailed;
    private bool removeFailed;
    private bool entryGone;
    private int loadedId = -1;
    private int? loadedEntry;
    private Meal? loadedMeal;

    /// <summary>Largest weight carried across a mode switch. A typed number can be astronomically large; it is invalid anyway, and this keeps the conversion within a decimal.</summary>
    private const double CarryLimit = 1_000_000;

    /// <summary>Id of the food to add.</summary>
    [Parameter, EditorRequired]
    public int FoodId { get; set; }

    /// <summary>The meal chosen before coming here, such as from a meal's +. Null suggests one from the time of day and shows the time it was suggested from. Edit mode needs it: null opens "Food not found".</summary>
    [Parameter]
    public Meal? Meal { get; set; }

    /// <summary>The day the entry is added to, or the entry's day in edit mode, where the default (no day) opens "Food not found" instead.</summary>
    [Parameter]
    public DateOnly Date { get; set; }

    /// <summary>What the snackbar after a saved entry offers.</summary>
    [Parameter]
    public AddedFollowUp AfterAdd { get; set; }

    /// <summary>Opens the day an entry was added to. Runs when "View day" is tapped, possibly after this screen is gone, so it is a plain delegate rather than an <see cref="EventCallback"/> bound to a screen that no longer exists.</summary>
    [Parameter]
    public Func<DateOnly, Task>? ViewDay { get; set; }

    /// <summary>Id of the entry to change or remove. Set puts the screen in edit mode: <see cref="Date"/> and <see cref="Meal"/> are the entry's, and Save changes it instead of adding one.</summary>
    [Parameter]
    public int? EntryId { get; set; }

    /// <summary>The entry's stored weight in g or ml, for edit mode. Null opens "Food not found" rather than defaults that would overwrite the entry.</summary>
    [Parameter]
    public double? EntryAmount { get; set; }

    /// <summary>The count of servings the entry was added by, for edit mode. Null when it was added by weight, or the food no longer has a serving.</summary>
    [Parameter]
    public double? EntryServings { get; set; }

    /// <summary>The serving the entry counted its servings in, for edit mode. Null, or one the food no longer has, opens on the smallest serving.</summary>
    [Parameter]
    public int? EntryServingId { get; set; }

    /// <summary>The weight in g or ml to open an added food with, instead of 1 serving or 100 g. Ignored in edit mode and when it is not a valid amount.</summary>
    [Parameter]
    public double? StartAmount { get; set; }

    /// <summary>The count of servings <see cref="StartAmount"/> was entered as; the screen opens in servings mode with it when the food has a serving. Null opens by weight.</summary>
    [Parameter]
    public double? StartServings { get; set; }

    /// <summary>The serving <see cref="StartServings"/> was counted in, such as the one last logged. Null, or one the food no longer has, opens on the smallest. Ignored in edit mode.</summary>
    [Parameter]
    public int? StartServingId { get; set; }

    /// <summary>Raised once an edited entry is saved.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>Raised once the entry is removed (or was already gone), after the Undo snackbar is posted.</summary>
    [Parameter]
    public EventCallback OnRemoved { get; set; }

    /// <summary>Raised once the entry is saved, after its snackbar is posted.</summary>
    [Parameter]
    public EventCallback OnAdded { get; set; }

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    private bool Editing => EntryId is not null;

    private bool HasServing => ServingRules.HasServing(offered);

    private double? Grams =>
        mode == EntryMode.Servings && HasServing
            ? lockedGrams ?? (amount is { } count ? (double)count * chosen!.Amount : null)
            : amount is { } typed ? (double)typed : null;

    protected override void OnInitialized()
    {
        // A message carried over from another screen (such as the Dashboard's "removed" Undo) is not Serving's to show.
        Snackbar.Dismiss();
        star = new FavouriteStar(Favourites, Snackbar, Logger, () => _ = InvokeAsync(StateHasChanged));
    }

    public void Dispose() => star.Dispose();

    protected override async Task OnParametersSetAsync()
    {
        var foodChanged = FoodId != loadedId || EntryId != loadedEntry;
        if (!foodChanged && Meal == loadedMeal)
        {
            return;
        }

        loadedMeal = Meal;
        if (Meal is { } preset)
        {
            meal = preset;
            suggestedAt = null;
        }
        else if (Editing)
        {
            meal = default;
            suggestedAt = null;
        }
        else
        {
            var now = TimeOnly.FromDateTime(Time.GetLocalNow().DateTime);
            meal = MealSuggestion.For(now);
            suggestedAt = now;
        }

        saveFailed = false;
        if (foodChanged)
        {
            loadedId = FoodId;
            loadedEntry = EntryId;
            entryGone = false;
            removeFailed = false;
            await LoadAsync();
        }
    }

    /// <summary>Shows the food first and reads the star after it, so the screen never waits on the star.</summary>
    private async Task LoadAsync()
    {
        var requested = FoodId;
        var requestedEntry = EntryId;
        await LoadFoodAsync();
        if (!loading && food is { } loaded && requested == FoodId && requestedEntry == EntryId)
        {
            StateHasChanged();
            await star.LoadAsync(loaded.Id);
        }
    }

    private async Task LoadFoodAsync()
    {
        var requested = FoodId;
        var requestedEntry = EntryId;
        loading = true;
        loadFailed = false;
        if (Editing && (Meal is null || Date == default || EntryAmount is null))
        {
            // The route can't say what the entry holds, so Save would overwrite it with defaults: show nothing to save.
            loading = false;
            food = null;
            star.Clear();
            return;
        }

        var result = await Foods.GetAsync(requested);
        if (requested != FoodId || requestedEntry != EntryId)
        {
            return;
        }

        star.Clear();
        loading = false;
        loadFailed = result.Status == FoodStatus.Failed;
        food = result.Food;
        offered = result.Servings;
        addingOwn = false;
        ownError = null;
        if (food is null)
        {
            return;
        }

        chosen = ServingRules.Pick(offered, Editing ? EntryServingId : StartServingId);
        entryServingUnmatched = Editing && offered.All(s => s.Id != EntryServingId);
        if (Editing && EntryAmount is { } stored)
        {
            // An entry with no serving link, or one whose serving is not offered any more, has a count in a serving it can't name: keep its weight and drop the count.
            Carry(stored, entryServingUnmatched ? null : EntryServings);
            return;
        }

        if (StartAmount is { } start && ServingRules.IsValidGrams(start))
        {
            Carry(start, StartServings);
            return;
        }

        if (HasServing)
        {
            mode = EntryMode.Servings;
            amount = 1;
        }
        else
        {
            mode = EntryMode.Grams;
            amount = 100;
        }

        lockedGrams = null;
        saveFailed = false;
    }

    private void ChangeMode(EntryMode next)
    {
        if (next == mode || !HasServing)
        {
            return;
        }

        var grams = Grams is { } raw ? Math.Min(raw, CarryLimit) : (double?)null;
        mode = next;
        entryServingUnmatched = false;
        saveFailed = false;
        removeFailed = false;
        if (next == EntryMode.Grams)
        {
            amount = grams is { } g ? ToDecimal(g) : null;
            lockedGrams = null;
        }
        else
        {
            var weight = chosen!.Amount;
            amount = grams is { } g ? Math.Round((decimal)(g / weight), 2) : null;
            lockedGrams = grams;
        }
    }

    /// <summary>The weight as a decimal without the binary noise of a double (201.8, not 201.80000000000001).</summary>
    /// <summary>Opens with an amount already known: in servings when the food has a serving and <paramref name="servings"/> is above zero (the grams stay as given), else by weight. Either is held at <see cref="CarryLimit"/>.</summary>
    private void Carry(double grams, double? servings)
    {
        if (HasServing && servings is > 0)
        {
            mode = EntryMode.Servings;
            amount = ToDecimal(Math.Min(servings.Value, CarryLimit));
            lockedGrams = grams;
        }
        else
        {
            mode = EntryMode.Grams;
            amount = ToDecimal(Math.Min(grams, CarryLimit));
            lockedGrams = null;
        }

        saveFailed = false;
    }

    private static decimal ToDecimal(double value) =>
        decimal.Parse(value.ToString("0.####", CultureInfo.InvariantCulture), CultureInfo.InvariantCulture);

    private void UseServing()
    {
        if (!HasServing)
        {
            return;
        }

        mode = EntryMode.Servings;
        amount = 1;
        lockedGrams = null;
        saveFailed = false;
        removeFailed = false;
    }

    /// <summary>Counts the same number of servings of another serving.</summary>
    private void ChangeServing(int id)
    {
        if (offered.FirstOrDefault(s => s.Id == id) is not { } next)
        {
            return;
        }

        chosen = next;
        entryServingUnmatched = false;
        lockedGrams = null;
        saveFailed = false;
        removeFailed = false;
    }

    private void OpenOwn()
    {
        addingOwn = true;
        ownLabel = "";
        ownAmount = null;
        ownError = null;
    }

    private void CancelOwn()
    {
        addingOwn = false;
        ownError = null;
    }

    private void ChangeOwnLabel(string value)
    {
        ownLabel = value;
        ownError = null;
    }

    private void ChangeOwnAmount(decimal? value)
    {
        ownAmount = value;
        ownError = null;
    }

    /// <summary>Saves the typed serving as the person's own and opens the food on it, counting one.</summary>
    private async Task SaveOwnAsync()
    {
        if (savingOwn || food is null || !FoodService.TryBoundServing(ownLabel, (double?)ownAmount, out var label, out var size))
        {
            return;
        }

        savingOwn = true;
        ownError = null;
        try
        {
            var result = await ServingsApi.AddAsync(food.Id, label, size);
            if (result.Status == ServingStatus.Ok)
            {
                await ReloadServingsAsync(result.Serving!.Id);
                mode = EntryMode.Servings;
                amount = 1;
                lockedGrams = null;
                saveFailed = false;
                return;
            }

            ownError = result.Status switch
            {
                ServingStatus.Duplicate => "You already have a serving of that size.",
                ServingStatus.Invalid => "Check the name and size.",
                _ => "Couldn't save this serving. Try again.",
            };
        }
        finally
        {
            savingOwn = false;
        }
    }

    /// <summary>Deletes the chosen serving. Entries that used it keep their amounts; the screen opens on the smallest serving.</summary>
    private async Task DeleteOwnAsync()
    {
        if (savingOwn || chosen is not { } own)
        {
            return;
        }

        savingOwn = true;
        try
        {
            var result = await ServingsApi.RemoveAsync(own.Id);
            if (result.Status is ServingStatus.Ok or ServingStatus.NotFound)
            {
                var grams = Grams;
                await ReloadServingsAsync(null);
                if (!HasServing)
                {
                    mode = EntryMode.Grams;
                    amount = grams is { } kept ? ToDecimal(Math.Min(kept, CarryLimit)) : null;
                    lockedGrams = null;
                }
                else if (mode == EntryMode.Servings)
                {
                    lockedGrams = null;
                }

                saveFailed = false;
            }
            else
            {
                ownError = "Couldn't delete this serving. Try again.";
                addingOwn = true;
            }
        }
        finally
        {
            savingOwn = false;
        }
    }

    /// <summary>Reads the food's servings again after one was added or deleted and picks <paramref name="pick"/>, else as on opening.</summary>
    private async Task ReloadServingsAsync(int? pick)
    {
        var requested = FoodId;
        var result = await Foods.GetAsync(requested);
        if (requested != FoodId)
        {
            return;
        }

        if (result.Status == FoodStatus.Found)
        {
            offered = result.Servings;
        }
        else if (result.Status == FoodStatus.Failed)
        {
            loadFailed = true;
        }

        chosen = ServingRules.Pick(offered, pick);
        entryServingUnmatched = false;
        addingOwn = false;
        ownError = null;
    }

    private void ChangeAmount(decimal? value)
    {
        amount = value;
        lockedGrams = null;
        saveFailed = false;
        removeFailed = false;
    }

    private void ChangeMeal(Meal value)
    {
        meal = value;
        saveFailed = false;
        removeFailed = false;
    }

    private double? Servings => mode == EntryMode.Servings && HasServing && amount is { } count ? (double)count : null;

    /// <summary>The serving the count is in; null when the entry is by weight.</summary>
    private int? ServingIdToSave => Servings is null || entryServingUnmatched ? null : chosen?.Id;

    /// <summary>Runs one save or remove with its busy flag on and the errors cleared. A throw clears the flag, since the screen stays.</summary>
    private async Task<DiaryResult> RunAsync(bool removal, Func<Task<DiaryResult>> call)
    {
        saving = !removal;
        removing = removal;
        saveFailed = false;
        removeFailed = false;
        try
        {
            return await call();
        }
        catch
        {
            saving = false;
            removing = false;
            throw;
        }
    }

    private async Task AddAsync()
    {
        if (saving || removing || food is null || Grams is not { } grams || !ServingRules.IsValidGrams(grams))
        {
            return;
        }

        var result = await RunAsync(false, () => Diary.AddAsync(Date, meal, food.Id, grams, Servings, ServingIdToSave));
        saveFailed = result.Status != DiaryStatus.Ok;
        if (!saveFailed)
        {
            Announce(FoodDisplay.Of(food).Title, meal, Date, result.Entry!);
        }

        // After a save the screen is left, so stay busy: a tap between the save and the navigation must not add a second entry.
        saving = !saveFailed;

        if (!saveFailed)
        {
            await OnAdded.InvokeAsync();
        }
    }

    /// <summary>Saves the changed amount and meal of the entry. An entry gone meanwhile says so and keeps the screen.</summary>
    private async Task SaveAsync()
    {
        if (saving || removing || EntryId is not { } id || entryGone || food is null || Grams is not { } grams || !ServingRules.IsValidGrams(grams))
        {
            return;
        }

        var result = await RunAsync(false, () => Diary.UpdateAsync(id, Date, meal, grams, Servings, ServingIdToSave));
        entryGone = result.Status == DiaryStatus.NotFound;
        saveFailed = result.Status is not (DiaryStatus.Ok or DiaryStatus.NotFound);

        // After a save the screen is left, so stay busy: a second tap must not save again.
        saving = result.Status == DiaryStatus.Ok;
        if (saving)
        {
            await OnSaved.InvokeAsync();
        }
    }

    /// <summary>Removes the entry and posts "{food} removed" with Undo. An entry already gone is left as removed, with no message.</summary>
    private async Task RemoveAsync()
    {
        if (saving || removing || EntryId is not { } id)
        {
            return;
        }

        var text = food is null ? "Entry removed" : $"{FoodDisplay.Of(food).Title} removed";
        var result = await RunAsync(true, () => Diary.RemoveAsync(id));
        if (result.Status == DiaryStatus.Ok)
        {
            Snackbar.Show(text, "Undo", () => RestoreAsync(Diary, Snackbar, Logger, id));
        }

        removeFailed = result.Status is not (DiaryStatus.Ok or DiaryStatus.NotFound);
        removing = !removeFailed;
        if (removing)
        {
            await OnRemoved.InvokeAsync();
        }
    }

    /// <summary>Brings the removed entry back. An entry already back counts as undone. A failure is logged and said in a snackbar; it never throws.</summary>
    private static async Task RestoreAsync(DiaryService diary, SnackbarService snackbar, ILogger logger, int entryId)
    {
        var result = await diary.RestoreAsync(entryId);
        if (result.Status is not (DiaryStatus.Ok or DiaryStatus.NotFound))
        {
            Log.RestoreFailed(logger, result.Status);
            snackbar.Show("Couldn't undo. Add the food again.");
        }
    }

    /// <summary>Posts "{food} added to {meal}" with Undo or View day. The actions can run after this screen is gone, so they use nothing of it.</summary>
    private void Announce(string name, Meal addedTo, DateOnly day, DiaryEntry entry)
    {
        var text = $"{name} added to {addedTo}";
        if (AfterAdd == AddedFollowUp.ViewDay && ViewDay is { } viewDay)
        {
            Snackbar.Show(text, "View day", () => viewDay(day));
        }
        else
        {
            var (diary, snackbar, logger) = (Diary, Snackbar, Logger);
            Snackbar.Show(text, "Undo", () => AddUndo.RunAsync(diary, snackbar, status => Log.UndoFailed(logger, status), entry.Id));
        }
    }
}
