@using System.Globalization
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Diary
@using CalorieTracker.Core.Foods
@using CalorieTracker.UI.Components.Feedback
@using CalorieTracker.UI.Models.Serving
@using Microsoft.Extensions.Logging
@inject FoodService Foods
@inject DiaryService Diary
@inject TimeProvider Time
@inject SnackbarService Snackbar
@inject ILogger<ServingPage> Logger

<ServingView Food="food" Loading="loading" LoadFailed="loadFailed" Mode="mode" Amount="amount" Grams="Grams" Meal="meal" SuggestedAt="suggestedAt"
             Saving="saving" SaveFailed="saveFailed" Editing="Editing" Date="Date" RemoveFailed="removeFailed" EntryGone="entryGone" OnSave="SaveAsync" OnRemove="RemoveAsync" OnModeChanged="ChangeMode" OnAmountChanged="ChangeAmount" OnUseServing="UseServing"
             OnMealChanged="ChangeMeal" OnAdd="AddAsync" OnRetry="LoadAsync" OnBack="OnBack" />

@code {
    private Food? food;
    private bool loading = true;
    private bool loadFailed;
    private EntryMode mode = EntryMode.Servings;
    private decimal? amount;

    /// <summary>Set when switching from grams to servings so the weight stays exactly as it was, until the amount is edited.</summary>
    private double? lockedGrams;
    private Meal meal;
    private TimeOnly? suggestedAt;
    private bool saving;
    private bool saveFailed;
    private bool removeFailed;
    private bool entryGone;
    private int loadedId = -1;
    private int? loadedEntry;
    private Meal? loadedMeal;

    /// <summary>Largest weight carried across a mode switch. A typed number can be astronomically large; it is invalid anyway, and this keeps the conversion within a decimal.</summary>
    private const double CarryLimit = 1_000_000;

    /// <summary>Id of the food to add.</summary>
    [Parameter, EditorRequired]
    public int FoodId { get; set; }

    /// <summary>The meal chosen before coming here, such as from a meal's +. Null suggests one from the time of day and shows the time it was suggested from.</summary>
    [Parameter]
    public Meal? Meal { get; set; }

    /// <summary>The day the entry is added to.</summary>
    [Parameter]
    public DateOnly Date { get; set; }

    /// <summary>What the snackbar after a saved entry offers.</summary>
    [Parameter]
    public AddedFollowUp AfterAdd { get; set; }

    /// <summary>Opens the day an entry was added to. Runs when "View day" is tapped, possibly after this screen is gone, so it is a plain delegate rather than an <see cref="EventCallback"/> bound to a screen that no longer exists.</summary>
    [Parameter]
    public Func<DateOnly, Task>? ViewDay { get; set; }

    /// <summary>Id of the entry to change or remove. Set puts the screen in edit mode: <see cref="Date"/> and <see cref="Meal"/> are the entry's, and Save changes it instead of adding one.</summary>
    [Parameter]
    public int? EntryId { get; set; }

    /// <summary>The entry's stored weight in g or ml, for edit mode. Null opens with the same defaults as adding.</summary>
    [Parameter]
    public double? EntryAmount { get; set; }

    /// <summary>The count of servings the entry was added by, for edit mode. Null when it was added by weight, or the food no longer has a serving.</summary>
    [Parameter]
    public double? EntryServings { get; set; }

    /// <summary>Raised once an edited entry is saved.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>Raised once the entry is removed (or was already gone), after the Undo snackbar is posted.</summary>
    [Parameter]
    public EventCallback OnRemoved { get; set; }

    /// <summary>Raised once the entry is saved, after its snackbar is posted.</summary>
    [Parameter]
    public EventCallback OnAdded { get; set; }

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    private bool Editing => EntryId is not null;

    private bool HasServing => ServingRules.HasServing(food);

    private double? Grams =>
        mode == EntryMode.Servings && HasServing
            ? lockedGrams ?? (amount is { } count ? (double)count * food!.ServingAmount!.Value : null)
            : amount is { } typed ? (double)typed : null;

    protected override async Task OnParametersSetAsync()
    {
        var foodChanged = FoodId != loadedId || EntryId != loadedEntry;
        if (!foodChanged && Meal == loadedMeal)
        {
            return;
        }

        loadedMeal = Meal;
        if (Meal is { } preset)
        {
            meal = preset;
            suggestedAt = null;
        }
        else if (Editing)
        {
            meal = default;
            suggestedAt = null;
        }
        else
        {
            var now = TimeOnly.FromDateTime(Time.GetLocalNow().DateTime);
            meal = MealSuggestion.For(now);
            suggestedAt = now;
        }

        saveFailed = false;
        if (foodChanged)
        {
            loadedId = FoodId;
            loadedEntry = EntryId;
            entryGone = false;
            removeFailed = false;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var requested = FoodId;
        loading = true;
        loadFailed = false;
        var result = await Foods.GetAsync(requested);
        if (requested != FoodId)
        {
            return;
        }

        loading = false;
        loadFailed = result.Status == FoodStatus.Failed;
        food = result.Food;
        if (food is null)
        {
            return;
        }

        if (Editing && EntryAmount is { } stored)
        {
            if (HasServing && EntryServings is { } count)
            {
                mode = EntryMode.Servings;
                amount = ToDecimal(Math.Min(count, CarryLimit));
                lockedGrams = stored;
            }
            else
            {
                mode = EntryMode.Grams;
                amount = ToDecimal(Math.Min(stored, CarryLimit));
                lockedGrams = null;
            }

            saveFailed = false;
            return;
        }

        if (HasServing)
        {
            mode = EntryMode.Servings;
            amount = 1;
        }
        else
        {
            mode = EntryMode.Grams;
            amount = 100;
        }

        lockedGrams = null;
        saveFailed = false;
    }

    private void ChangeMode(EntryMode next)
    {
        if (next == mode || !HasServing)
        {
            return;
        }

        var grams = Grams is { } raw ? Math.Min(raw, CarryLimit) : (double?)null;
        mode = next;
        saveFailed = false;
        if (next == EntryMode.Grams)
        {
            amount = grams is { } g ? ToDecimal(g) : null;
            lockedGrams = null;
        }
        else
        {
            var weight = food!.ServingAmount!.Value;
            amount = grams is { } g ? Math.Round((decimal)(g / weight), 2) : null;
            lockedGrams = grams;
        }
    }

    /// <summary>The weight as a decimal without the binary noise of a double (201.8, not 201.80000000000001).</summary>
    private static decimal ToDecimal(double value) =>
        decimal.Parse(value.ToString("0.####", CultureInfo.InvariantCulture), CultureInfo.InvariantCulture);

    private void UseServing()
    {
        if (!HasServing)
        {
            return;
        }

        mode = EntryMode.Servings;
        amount = 1;
        lockedGrams = null;
        saveFailed = false;
    }

    private void ChangeAmount(decimal? value)
    {
        amount = value;
        lockedGrams = null;
        saveFailed = false;
        removeFailed = false;
    }

    private void ChangeMeal(Meal value)
    {
        meal = value;
        saveFailed = false;
        removeFailed = false;
    }

    private double? Servings => mode == EntryMode.Servings && HasServing && amount is { } count ? (double)count : null;

    private async Task AddAsync()
    {
        if (saving || food is null || Grams is not { } grams || !ServingRules.IsValidGrams(grams))
        {
            return;
        }

        var servings = Servings;
        saving = true;
        saveFailed = false;
        try
        {
            var result = await Diary.AddAsync(Date, meal, food.Id, grams, servings);
            saveFailed = result.Status != DiaryStatus.Ok;
            if (!saveFailed)
            {
                Announce(food.Name, meal, Date, result.Entry!);
            }
        }
        catch
        {
            saving = false;
            throw;
        }

        // After a save the screen is left, so stay busy: a tap between the save and the navigation must not add a second entry.
        saving = !saveFailed;

        if (!saveFailed)
        {
            await OnAdded.InvokeAsync();
        }
    }

    /// <summary>Saves the changed amount and meal of the entry. An entry gone meanwhile says so and keeps the screen.</summary>
    private async Task SaveAsync()
    {
        if (saving || EntryId is not { } id || entryGone || food is null || Grams is not { } grams || !ServingRules.IsValidGrams(grams))
        {
            return;
        }

        saving = true;
        saveFailed = false;
        removeFailed = false;
        DiaryResult result;
        try
        {
            result = await Diary.UpdateAsync(id, Date, meal, grams, Servings);
        }
        catch
        {
            saving = false;
            throw;
        }

        entryGone = result.Status == DiaryStatus.NotFound;
        saveFailed = result.Status is not (DiaryStatus.Ok or DiaryStatus.NotFound);

        // After a save the screen is left, so stay busy: a second tap must not save again.
        saving = result.Status == DiaryStatus.Ok;
        if (saving)
        {
            await OnSaved.InvokeAsync();
        }
    }

    /// <summary>Removes the entry and posts "{food} removed" with Undo. An entry already gone is left as removed, with no message.</summary>
    private async Task RemoveAsync()
    {
        if (saving || EntryId is not { } id || food is null)
        {
            return;
        }

        saving = true;
        saveFailed = false;
        removeFailed = false;
        DiaryResult result;
        try
        {
            result = await Diary.RemoveAsync(id);
        }
        catch
        {
            saving = false;
            throw;
        }

        if (result.Status == DiaryStatus.Ok)
        {
            Snackbar.Show($"{food.Name} removed", "Undo", () => RestoreAsync(Diary, Snackbar, Logger, id));
        }

        removeFailed = result.Status is not (DiaryStatus.Ok or DiaryStatus.NotFound);
        saving = !removeFailed;
        if (saving)
        {
            await OnRemoved.InvokeAsync();
        }
    }

    /// <summary>Brings the removed entry back. An entry already back counts as undone. A failure is logged and said in a snackbar; it never throws.</summary>
    private static async Task RestoreAsync(DiaryService diary, SnackbarService snackbar, ILogger logger, int entryId)
    {
        var result = await diary.RestoreAsync(entryId);
        if (result.Status is not (DiaryStatus.Ok or DiaryStatus.NotFound))
        {
            Log.RestoreFailed(logger, result.Status);
            snackbar.Show("Couldn't undo. Add the food again.");
        }
    }

    /// <summary>Posts "{food} added to {meal}" with Undo or View day. The actions can run after this screen is gone, so they use nothing of it.</summary>
    private void Announce(string name, Meal addedTo, DateOnly day, DiaryEntry entry)
    {
        var text = $"{name} added to {addedTo}";
        if (AfterAdd == AddedFollowUp.ViewDay && ViewDay is { } viewDay)
        {
            Snackbar.Show(text, "View day", () => viewDay(day));
        }
        else
        {
            Snackbar.Show(text, "Undo", () => UndoAsync(Diary, Snackbar, Logger, entry.Id));
        }
    }

    /// <summary>Removes the entry just added. An entry already gone counts as undone. A failure is logged and said in a snackbar; it never throws.</summary>
    private static async Task UndoAsync(DiaryService diary, SnackbarService snackbar, ILogger logger, int entryId)
    {
        var result = await diary.RemoveAsync(entryId);
        if (result.Status is not (DiaryStatus.Ok or DiaryStatus.NotFound))
        {
            Log.UndoFailed(logger, result.Status);
            snackbar.Show("Couldn't undo. Remove it from the day.");
        }
    }
}
