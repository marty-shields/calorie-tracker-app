@using Microsoft.Extensions.Logging
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Foods
@using CalorieTracker.Core.History
@using CalorieTracker.Core.Summary
@using CalorieTracker.UI.Components.Feedback
@using CalorieTracker.UI.Components.Layout
@inject DaySummaryService Summaries
@using CalorieTracker.Core.Diary
@implements IDisposable
@inject DiaryService Diary
@inject FoodHistoryService History
@inject FoodService Foods
@inject SnackbarService Snackbar
@inject ILogger<DashboardPage> Logger
@inject TimeProvider Time

<DashboardView Date="date" Today="Today()" Summary="summary" Loading="loading" LoadFailed="loadFailed"
               OnPrevious="@(() => ShowAsync(date.AddDays(-1)))" OnNext="@(() => ShowAsync(date.AddDays(1)))" OnToday="@(() => ShowAsync(Today()))"
               UsualFoods="usual" UsualAddError="@usualError" OnMealChanged="LoadUsualAsync" OnAddUsual="AddUsualAsync"
               OnAdd="OnAdd" OnScan="OnScan" OnEdit="OnEdit" OnRetry="LoadAsync" OnNavigate="OnNavigate" OnSettings="OnSettings" />

@code {
    private DateOnly date;
    private DaySummary? summary;
    private bool loading = true;
    private bool loadFailed;
    private const int UsualRows = 3;
    private DateOnly? openedWith;
    private bool opened;
    private bool disposed;
    private int usualRead;
    private bool adding;
    private IReadOnlyList<UsualFoodRow>? usual;
    private string? usualError;

    /// <summary>The day to open on the date strip, from the route's <c>date</c>. Null opens today. A change opens that day.</summary>
    [Parameter]
    public DateOnly? Date { get; set; }

    /// <summary>Raised with the meal and day when a meal's + or the Add sheet's Search foods is tapped.</summary>
    [Parameter]
    public EventCallback<MealAddRequest> OnAdd { get; set; }

    /// <summary>Raised with the meal and day when the Add sheet's Scan barcode is tapped.</summary>
    [Parameter]
    public EventCallback<MealAddRequest> OnScan { get; set; }

    /// <summary>Raised with the entry, its meal and the day when an entry is tapped.</summary>
    [Parameter]
    public EventCallback<EntryEditRequest> OnEdit { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    /// <summary>Raised by the Settings gear and by Set a target.</summary>
    [Parameter]
    public EventCallback OnSettings { get; set; }

    protected override void OnInitialized() => Diary.Changed += OnDiaryChanged;

    public void Dispose()
    {
        disposed = true;
        Diary.Changed -= OnDiaryChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        // No read yet means the first render; after that only a new Date parameter reopens a day.
        if (opened && openedWith == Date)
        {
            return;
        }

        opened = true;
        openedWith = Date;
        await ShowAsync(Date ?? Today());
    }

    /// <summary>Reads the foods usual for <paramref name="meal"/> for the Add sheet: up to 3 rows. The rows are cleared while reading; a failed read leaves none. A read that lands after a newer one is dropped.</summary>
    private async Task LoadUsualAsync(Meal meal)
    {
        var read = ++usualRead;
        usual = null;
        usualError = null;
        var history = await History.UsualAsync(meal, UsualRows);
        if (read != usualRead || disposed)
        {
            return;
        }

        if (history.Status != FoodHistoryStatus.Found)
        {
            Log.UsualReadFailed(Logger, meal);
            return;
        }

        var rows = new List<UsualFoodRow>();
        foreach (var entry in history.Foods)
        {
            var found = await Foods.GetAsync(entry.FoodId);
            if (read != usualRead || disposed)
            {
                return;
            }

            if (found is { Status: FoodStatus.Found, Food: { } food })
            {
                rows.Add(UsualFoodRow.From(food, found.Servings, entry));
            }
        }

        Log.UsualRead(Logger, meal, rows.Count);
        usual = rows;
    }

    /// <summary>Adds the usual food to the meal and day with its last amount, servings and serving, and posts "{title} added to {meal}" with Undo. False keeps the sheet open, with <see cref="usualError"/> saying what failed.</summary>
    private async Task<bool> AddUsualAsync(UsualAddRequest request, DateOnly day)
    {
        if (adding)
        {
            return false;
        }

        adding = true;
        try
        {
            var result = await Diary.AddAsync(day, request.Meal, request.Food.FoodId, request.Food.LastAmount, request.Food.LastServings, request.Food.LastServingId);
            if (result.Status != DiaryStatus.Ok || result.Entry is not { } entry)
            {
                Log.UsualAddFailed(Logger, request.Food.FoodId, request.Meal, result.Status);
                usualError = $"Couldn't add {request.Food.Title} to {request.Meal}. Try again.";
                StateHasChanged();
                return false;
            }

            Log.UsualAdded(Logger, request.Food.FoodId, request.Meal);
            usualError = null;
            var (diary, snackbar, logger) = (Diary, Snackbar, Logger);
            Snackbar.Show($"{request.Food.Title} added to {request.Meal}", "Undo", () => AddUndo.RunAsync(diary, snackbar, status => Log.UsualUndoFailed(logger, status), entry.Id));
            return true;
        }
        finally
        {
            adding = false;
        }
    }

    /// <summary>Today by the clock now, so the screen is right when it is used past midnight.</summary>
    private DateOnly Today() => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    private Task ShowAsync(DateOnly day)
    {
        date = day;
        return LoadAsync();
    }

    /// <summary>Reads the day on the strip. Reads queue behind each other in the database gate, so they land in the order asked.</summary>
    private Task LoadAsync() => LoadAsync(blank: true);

    /// <param name="blank">Show the spinner while reading. False keeps the day on screen until the new read lands, for a change made elsewhere.</param>
    private async Task LoadAsync(bool blank)
    {
        var day = date;
        if (blank)
        {
            loading = true;
            loadFailed = false;
            summary = null;
        }

        var result = await Summaries.GetAsync(day);
        loading = false;
        loadFailed = result.Status != DaySummaryStatus.Ok;
        summary = result.Summary;
    }

    /// <summary>An entry was added, changed, removed or restored (an Undo, for one): read the day again.</summary>
    private void OnDiaryChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed)
        {
            return;
        }

        await LoadAsync(blank: false);
        if (!disposed)
        {
            StateHasChanged();
        }
    });
}
