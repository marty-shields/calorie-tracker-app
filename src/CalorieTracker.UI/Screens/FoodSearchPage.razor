@implements IDisposable
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Foods
@using CalorieTracker.Core.Seed
@using Microsoft.Extensions.Logging
@inject IFoodSearch Search
@inject SeedProgress Seed
@inject ILogger<FoodSearchPage> Logger

<FoodSearchView Query="@query" Results="results" Selected="selected" Loading="loading" Failed="failed"
                OnQueryChanged="SearchAsync" OnSelect="Select" OnClearSelection="ClearSelection" OnRetry="Retry" OnNavigate="OnNavigate" />

@code {
    private string query = "";
    private IReadOnlyList<Food> results = [];
    private Food? selected;
    private bool loading;
    private bool failed;
    private bool seedFailed;
    private bool disposed;
    private CancellationTokenSource? running;

    /// <summary>Raised with the destination tapped in the bottom navigation bar, or with the start screen on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Seed.Current is { } load)
        {
            await WaitForSeedAsync(load);
        }
    }

    /// <summary>Shows the loading state until the food seed finishes, then repeats what was typed meanwhile.</summary>
    private async Task WaitForSeedAsync(Task<SeedLoadResult> load)
    {
        var waited = !load.IsCompleted;
        loading = waited;
        var result = await load;
        if (disposed)
        {
            return;
        }

        loading = false;
        seedFailed = result.Status == SeedLoadStatus.Failed;
        failed = seedFailed;
        if (waited)
        {
            Log.SeedWaited(Logger, result.Status);
        }

        if (!seedFailed)
        {
            await SearchAsync(query);
        }
    }

    /// <summary>Searches as the user types; a newer keystroke cancels the search still running. While the seed loads, the text is kept and searched once it finishes.</summary>
    private async Task SearchAsync(string text)
    {
        query = text;
        running?.Cancel();
        if (loading)
        {
            return;
        }

        running = new CancellationTokenSource();
        try
        {
            var result = await Search.SearchAsync(text, ct: running.Token);
            failed = seedFailed || result.Status == FoodSearchStatus.Failed;
            results = result.Foods;
            if (result.Status == FoodSearchStatus.Failed)
            {
                Log.SearchFailed(Logger);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void Select(Food food) => selected = food;

    private void ClearSelection() => selected = null;

    private Task Retry()
    {
        if (!seedFailed)
        {
            return SearchAsync(query);
        }

        Log.SeedRetried(Logger);
        failed = false;
        return WaitForSeedAsync(Seed.Start());
    }

    public void Dispose()
    {
        disposed = true;
        running?.Cancel();
    }
}
