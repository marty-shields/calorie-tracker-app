@implements IDisposable
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Foods
@using CalorieTracker.Core.Seed
@using Microsoft.Extensions.Logging
@inject IFoodSearch Search
@inject SeedProgress Seed
@inject ILogger<FoodSearchPage> Logger

<FoodSearchView Meal="Meal" Query="@query" Groups="groups" Expanded="expanded" OnExpand="Expand" Selected="selected" Loading="loading" Failed="failed"
                OnQueryChanged="SearchAsync" OnSelect="SelectAsync" OnAdd="AddAsync" OnBack="OnBack" OnClearSelection="ClearSelection" OnRetry="Retry" OnNavigate="OnNavigate" />

@code {
    private string query = "";
    private IReadOnlyList<FoodGroup> groups = [];
    private readonly HashSet<FoodGroupKind> expanded = [];
    private Food? selected;
    private bool loading;
    private bool failed;
    private bool seedFailed;
    private bool disposed;

    /// <summary>Set by the first result tapped in add mode, so a double tap adds once. The page is left on the way out, so it is never cleared.</summary>
    private bool added;
    private CancellationTokenSource? running;

    /// <summary>The meal being added to. Set, the page is in add mode: tapping a result raises <see cref="OnAdd"/> straight away instead of showing the food's values.</summary>
    [Parameter]
    public Meal? Meal { get; set; }

    /// <summary>The text the search opens with, such as when coming back from adding a food. Read once, when the page starts.</summary>
    [Parameter]
    public string? InitialQuery { get; set; }

    /// <summary>Raised to add a food: from a result in add mode, or Add to diary on a food's values. Carries the search so it can be restored on the way back.</summary>
    [Parameter]
    public EventCallback<FoodAddRequest> OnAdd { get; set; }

    /// <summary>Raised by the back arrow and Android back in add mode.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, or with the start screen on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    protected override async Task OnInitializedAsync()
    {
        query = InitialQuery ?? "";
        if (Seed.Current is { } load)
        {
            await WaitForSeedAsync(load);
        }
        else
        {
            await SearchAsync(query);
        }
    }

    /// <summary>Shows the loading state until the food seed finishes, then repeats what was typed meanwhile.</summary>
    private async Task WaitForSeedAsync(Task<SeedLoadResult> load)
    {
        var waited = !load.IsCompleted;
        loading = waited;
        var result = await load;
        if (disposed)
        {
            return;
        }

        loading = false;
        seedFailed = result.Status == SeedLoadStatus.Failed;
        failed = seedFailed;
        if (waited)
        {
            Log.SeedWaited(Logger, result.Status);
        }

        if (!seedFailed)
        {
            await SearchAsync(query);
        }
    }

    /// <summary>Searches as the user types; a newer keystroke cancels the search still running. While the seed loads, the text is kept and searched once it finishes.</summary>
    private async Task SearchAsync(string text)
    {
        query = text;
        CancelRunning();
        if (loading)
        {
            return;
        }

        var source = running = new CancellationTokenSource();
        var token = source.Token;
        try
        {
            var typed = !string.IsNullOrWhiteSpace(text);
            var result = typed ? await Search.SearchGroupedAsync(text, Meal, token) : await Search.SuggestAsync(Meal, token);
            if (token.IsCancellationRequested)
            {
                return;
            }

            // A failed read of the foods to start from is not an error: the screen shows its empty prompt and typing still works.
            failed = seedFailed || (typed && result.Status == FoodSearchStatus.Failed);
            groups = result.Groups;
            expanded.Clear();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelRunning()
    {
        if (running is null)
        {
            return;
        }

        running.Cancel();
        running.Dispose();
        running = null;
    }

    private Task SelectAsync(Food food)
    {
        if (Meal is null)
        {
            selected = food;
            return Task.CompletedTask;
        }

        if (added)
        {
            return Task.CompletedTask;
        }

        added = true;
        return AddAsync(food);
    }

    private void Expand(FoodGroupKind kind) => expanded.Add(kind);

    /// <summary>Carries the amount last logged, when the food was logged before, so Serving opens with it filled in.</summary>
    private Task AddAsync(Food food)
    {
        var last = groups.SelectMany(g => g.Foods).FirstOrDefault(l => l.Food.Id == food.Id)?.History;
        return OnAdd.InvokeAsync(new FoodAddRequest(food, query, last?.LastAmount, last?.LastServings));
    }

    private void ClearSelection() => selected = null;

    private Task Retry()
    {
        if (!seedFailed)
        {
            return SearchAsync(query);
        }

        Log.SeedRetried(Logger);
        failed = false;
        return WaitForSeedAsync(Seed.Start());
    }

    public void Dispose()
    {
        disposed = true;
        CancelRunning();
    }
}
