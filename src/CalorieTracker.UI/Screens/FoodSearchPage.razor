@implements IDisposable
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Foods
@using CalorieTracker.Core.Seed
@using CalorieTracker.UI.Components.Feedback
@using CalorieTracker.UI.Models.Search
@using Microsoft.Extensions.Logging
@inject IFoodSearch Search
@inject IOnlineFoodSearch OnlineSearch
@inject IOnlineFoodImport OnlineImport
@inject IOnlineSearchNotice OnlineNotice
@inject SeedProgress Seed
@inject FavouriteService Favourites
@inject SnackbarService Snackbar
@inject ILogger<FoodSearchPage> Logger

<FoodSearchView Meal="Meal" Query="@query" Groups="groups" Expanded="expanded" OnExpand="Expand" Selected="selected" Favourite="star.IsFavourite" OnToggleFavourite="star.ToggleAsync" Loading="loading" Failed="failed"
                OnQueryChanged="SearchAsync" OnSelect="SelectAsync" OnAdd="AddAsync" OnBack="OnBack" OnClearSelection="ClearSelection" OnRetry="Retry" OnNavigate="OnNavigate"
                OnlineState="onlineState" OnlineProducts="onlineProducts" OnlineCountry="@onlineCountry" OnlineExpanded="onlineExpanded" OnlineNoticeVisible="noticeVisible"
                OnSearchOnline="SearchOnlineAsync" OnSelectOnline="SelectOnlineAsync" OnExpandOnline="ExpandOnline" OnRetryOnline="RetryOnlineAsync" />

@code {
    private FavouriteStar star = null!;
    private string query = "";
    private IReadOnlyList<FoodGroup> groups = [];
    private readonly HashSet<FoodGroupKind> expanded = [];
    private Food? selected;
    private bool loading;
    private bool failed;
    private bool seedFailed;
    private bool disposed;

    private OnlineSearchState onlineState;
    private IReadOnlyList<OnlineProduct> onlineProducts = [];
    private string? onlineCountry;
    private bool onlineExpanded;
    private bool noticeVisible;
    private CancellationTokenSource? onlineRunning;

    /// <summary>The product tapped last, so Try again fetches it again; null when the last tap was the search.</summary>
    private OnlineProduct? lastTapped;

    /// <summary>Set by the first result tapped in add mode, so a double tap adds once. The page is left on the way out, so it is never cleared.</summary>
    private bool added;
    private CancellationTokenSource? running;

    /// <summary>The meal being added to. Set, the page is in add mode: tapping a result raises <see cref="OnAdd"/> straight away instead of showing the food's values.</summary>
    [Parameter]
    public Meal? Meal { get; set; }

    /// <summary>The text the search opens with, such as when coming back from adding a food. Read once, when the page starts.</summary>
    [Parameter]
    public string? InitialQuery { get; set; }

    /// <summary>Raised to add a food: from a result in add mode, or Add to diary on a food's values. Carries the search so it can be restored on the way back.</summary>
    [Parameter]
    public EventCallback<FoodAddRequest> OnAdd { get; set; }

    /// <summary>Raised by the back arrow and Android back in add mode.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, or with the start screen on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    protected override async Task OnInitializedAsync()
    {
        star = new FavouriteStar(Favourites, Snackbar, Logger, () => _ = InvokeAsync(StateHasChanged));
        query = InitialQuery ?? "";
        var notice = ReadNoticeAsync();
        if (Seed.Current is { } load)
        {
            await WaitForSeedAsync(load);
        }
        else
        {
            await SearchAsync(query);
        }

        await notice;
    }

    private async Task ReadNoticeAsync() => noticeVisible = !await OnlineNotice.WasShownAsync();

    /// <summary>Shows the loading state until the food seed finishes, then repeats what was typed meanwhile.</summary>
    private async Task WaitForSeedAsync(Task<SeedLoadResult> load)
    {
        var waited = !load.IsCompleted;
        loading = waited;
        var result = await load;
        if (disposed)
        {
            return;
        }

        loading = false;
        seedFailed = result.Status == SeedLoadStatus.Failed;
        failed = seedFailed;
        if (waited)
        {
            Log.SeedWaited(Logger, result.Status);
        }

        if (!seedFailed)
        {
            await SearchAsync(query);
        }
    }

    /// <summary>Searches as the user types; a newer keystroke cancels the search still running. While the seed loads, the text is kept and searched once it finishes.</summary>
    private async Task SearchAsync(string text)
    {
        if (text != query)
        {
            ResetOnline();
        }

        query = text;
        CancelRunning();
        if (loading)
        {
            return;
        }

        var source = running = new CancellationTokenSource();
        var token = source.Token;
        try
        {
            var typed = !string.IsNullOrWhiteSpace(text);
            var result = typed ? await Search.SearchGroupedAsync(text, Meal, token) : await Search.SuggestAsync(Meal, token);
            if (token.IsCancellationRequested)
            {
                return;
            }

            // A failed read of the foods to start from is not an error: the screen shows its empty prompt and typing still works.
            failed = seedFailed || (typed && result.Status == FoodSearchStatus.Failed);
            groups = result.Groups;
            expanded.Clear();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelRunning()
    {
        if (running is null)
        {
            return;
        }

        running.Cancel();
        running.Dispose();
        running = null;
    }

    private async Task SelectAsync(Food food)
    {
        if (onlineState == OnlineSearchState.Importing)
        {
            return;
        }

        if (Meal is null)
        {
            await star.LoadAsync(food.Id);
            selected = food;
            return;
        }

        if (added)
        {
            return;
        }

        added = true;
        await AddAsync(food);
    }

    private void Expand(FoodGroupKind kind) => expanded.Add(kind);

    private void ExpandOnline() => onlineExpanded = true;

    /// <summary>The typed text changed: what the online search answered belongs to the old text, so it goes (the session cache brings it back for the same text), and a search or fetch still running is let go.</summary>
    private void ResetOnline()
    {
        CancelOnline();
        onlineState = OnlineSearchState.Idle;
        onlineProducts = [];
        onlineCountry = null;
        onlineExpanded = false;
        lastTapped = null;
    }

    private void CancelOnline()
    {
        onlineRunning?.Cancel();
        onlineRunning?.Dispose();
        onlineRunning = null;
    }

    /// <summary>The tap that sends the typed text to the online search. Nothing else does; the first tap also counts as the person having seen the notice.</summary>
    private async Task SearchOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(query) || onlineState is OnlineSearchState.Searching or OnlineSearchState.Importing)
        {
            return;
        }

        lastTapped = null;
        var text = query;
        CancelOnline();
        var source = onlineRunning = new CancellationTokenSource();
        var token = source.Token;
        onlineState = OnlineSearchState.Searching;
        onlineProducts = [];
        onlineExpanded = false;
        if (noticeVisible)
        {
            noticeVisible = false;
            await OnlineNotice.MarkShownAsync();
        }

        OnlineSearchResult result;
        try
        {
            result = await OnlineSearch.SearchAsync(text, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        // The text changed (or the page went) while the search ran: its answer is for something else.
        if (disposed || token.IsCancellationRequested)
        {
            return;
        }

        onlineCountry = result.Country;
        onlineProducts = result.Products;
        onlineState = result.Status switch
        {
            OnlineSearchStatus.Found => OnlineSearchState.Results,
            OnlineSearchStatus.None => OnlineSearchState.None,
            OnlineSearchStatus.Limited => OnlineSearchState.Busy,
            OnlineSearchStatus.Offline => OnlineSearchState.Offline,
            _ => OnlineSearchState.Failed,
        };
    }

    /// <summary>Stores the tapped product as a scan would and goes on with the food: Serving on the pack in add mode, the food's values on the Foods tab.</summary>
    private async Task SelectOnlineAsync(OnlineProduct product)
    {
        if (onlineState == OnlineSearchState.Importing || added)
        {
            return;
        }

        lastTapped = product;
        CancelOnline();
        var source = onlineRunning = new CancellationTokenSource();
        onlineState = OnlineSearchState.Importing;
        OnlineImportResult result;
        try
        {
            result = await OnlineImport.ImportAsync(product.Barcode, source.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (disposed || source.IsCancellationRequested)
        {
            return;
        }

        if (result is not { Status: OnlineImportStatus.Imported, Food: { } food })
        {
            onlineState = result.Status switch
            {
                OnlineImportStatus.Limited => OnlineSearchState.Busy,
                OnlineImportStatus.Offline => OnlineSearchState.Offline,
                OnlineImportStatus.NotFound => OnlineSearchState.Unavailable,
                _ => OnlineSearchState.Failed,
            };
            return;
        }

        // The product is stored now; its row is no longer new when the list is shown again.
        onlineProducts = onlineProducts.Select(p => p.Barcode == product.Barcode ? p with { IsNew = false } : p).ToList();
        onlineState = OnlineSearchState.Results;
        lastTapped = null;
        if (Meal is null)
        {
            await star.LoadAsync(food.Id);
            selected = food;
            return;
        }

        added = true;
        await AddAsync(food);
    }

    private Task RetryOnlineAsync() => lastTapped is { } product ? SelectOnlineAsync(product) : SearchOnlineAsync();

    /// <summary>Carries the amount last logged, when the food was logged before, so Serving opens with it filled in. A food not in the list (an online result) is looked up.</summary>
    private async Task AddAsync(Food food)
    {
        var listed = groups.SelectMany(g => g.Foods).FirstOrDefault(l => l.Food.Id == food.Id);
        var last = listed is not null ? listed.History : await Search.LastLoggedAsync(food.Id, Meal);
        await OnAdd.InvokeAsync(new FoodAddRequest(food, query, last?.LastAmount, last?.LastServings, last?.LastServingId));
    }

    private void ClearSelection()
    {
        selected = null;
        star.Clear();
    }

    private Task Retry()
    {
        if (!seedFailed)
        {
            return SearchAsync(query);
        }

        Log.SeedRetried(Logger);
        failed = false;
        return WaitForSeedAsync(Seed.Start());
    }

    public void Dispose()
    {
        disposed = true;
        star.Dispose();
        CancelRunning();
        CancelOnline();
    }
}
