@using System.Globalization
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Diary
@using CalorieTracker.Core.Foods
@using CalorieTracker.UI.Models.Serving
<AppScreen Title="@(Display is { } titled ? titled.Title : Editing ? "Edit entry" : "Add food")" OnBack="OnBack">
    <Actions>
        @if (Favourite is { } favourite && Food is not null && !Loading && !LoadFailed)
        {
            <IconButton Icon="FavouriteStar.IconFor(favourite)" AriaLabel="@FavouriteStar.LabelFor(favourite)" Pressed="favourite" TestId="serving-favourite" OnClick="OnToggleFavourite" />
        }
        @if (Editing && Food is not null && !Loading && !LoadFailed)
        {
            <IconButton Icon="IconName.Delete" AriaLabel="Remove entry" TestId="serving-remove" OnClick="OnRemove" />
        }
    </Actions>
    <ChildContent>
        @if (Loading)
        {
            <div class="centre">
                <Spinner Label="Loading food…" TestId="serving-loading" />
            </div>
        }
        else if (LoadFailed)
        {
            <LoadFailed Message="Couldn't load this food" TestId="serving-load-failed" OnRetry="OnRetry" />
        }
        else if (Food is not { } food)
        {
            <div class="centre">
                <EmptyState Message="Food not found" TestId="serving-not-found" />
            </div>
        }
        else
        {
            var mode = HasServing ? Mode : EntryMode.Grams;
            var servings = mode == EntryMode.Servings;
            <div class="body">
                @if (Display?.Detail is { } detail)
                {
                    <Shields.UI.Components.Layout.Text Variant="TextVariant.Muted" As="TextElement.P" TestId="serving-brand" data-wrap-ok>@detail</Shields.UI.Components.Layout.Text>
                }
                @if (Editing)
                {
                    <Shields.UI.Components.Layout.Text Variant="TextVariant.Muted" As="TextElement.P" TestId="serving-when">@Meal · @Date.ToString("d MMM", CultureInfo.InvariantCulture)</Shields.UI.Components.Layout.Text>
                }
                else
                {
                    <Shields.UI.Components.Layout.Text Variant="TextVariant.Muted" As="TextElement.P" TestId="serving-per" data-wrap-ok>@PerLine(food)</Shields.UI.Components.Layout.Text>
                }
                @if (HasServing)
                {
                    <section class="section">
                        <Text Variant="TextVariant.Label" As="TextElement.H2">Enter as</Text>
                        <SegmentedControl TValue="EntryMode" Label="Enter as" Options="Modes" Value="mode" ValueChanged="OnModeChanged" TestId="serving-mode" />
                        @if (servings && Servings.Count > 1)
                        {
                            <SelectField TValue="int" Label="Serving" Options="ServingOptions" Value="Chosen!.Id" ValueChanged="OnServingChanged" TestId="serving-select" />
                        }
                        else if (servings)
                        {
                            <Card TestId="serving-label"><Text Variant="TextVariant.Strong" data-wrap-ok>@Chosen!.Label</Text></Card>
                        }
                    </section>
                }
                <section class="section">
                    <Text Variant="TextVariant.Label" As="TextElement.H2">@(servings ? "How many" : "Amount")</Text>
                    <NumberField Label="@(servings ? "Servings" : "Amount")" Value="Amount" ValueChanged="OnAmountChanged" Unit="@(servings ? "serving" : UnitText(food))" Stepper
                                 Step="@(servings ? 1 : 10)" Minimum="0" InvalidMessage="@InvalidMessage(food, servings)" TestId="serving-amount" />
                    @if (servings && Valid)
                    {
                        <Shields.UI.Components.Layout.Text Variant="TextVariant.Muted" As="TextElement.P" TestId="serving-weight">= @Weight(Grams!.Value) @UnitText(food)</Shields.UI.Components.Layout.Text>
                    }
                    @if (HasServing && !servings)
                    {
                        <AppButton Variant="ButtonVariant.Secondary" FullWidth TestId="serving-use-serving" OnClick="OnUseServing"><span data-wrap-ok>Use serving: @Chosen!.Label</span></AppButton>
                    }
                </section>
                <section class="section">
                    <Text Variant="TextVariant.Label" As="TextElement.H2">Your servings</Text>
                    @if (AddingOwn)
                    {
                        <TextField Label="Serving name" Value="@OwnLabel" ValueChanged="OnOwnLabelChanged" MaxLength="FoodService.MaxServingLabelLength" Placeholder="Serving name, such as 1 slice"
                                   InvalidMessage="@OwnLabelMessage" TestId="serving-own-label" />
                        <NumberField Label="Serving size" Value="OwnAmount" ValueChanged="OnOwnAmountChanged" Unit="@UnitText(food)" InvalidMessage="@OwnAmountMessage(food)" TestId="serving-own-amount" />
                        <InlineAlert Message="@OwnError" TestId="serving-own-error" />
                        <div class="own-actions">
                            <AppButton Variant="ButtonVariant.Secondary" FullWidth Disabled="SavingOwn" TestId="serving-own-cancel" OnClick="OnOwnCancel">Cancel</AppButton>
                            <AppButton FullWidth Busy="SavingOwn" Disabled="!OwnValid" TestId="serving-own-save" OnClick="OnOwnSave">@(SavingOwn ? "Saving…" : "Save serving")</AppButton>
                        </div>
                    }
                    else
                    {
                        <AppButton Variant="ButtonVariant.Secondary" FullWidth TestId="serving-own-add" OnClick="OnOwnOpen">Add your own serving</AppButton>
                        @if (HasServing)
                        {
                            <AppButton Variant="ButtonVariant.Secondary" FullWidth TestId="serving-own-delete" OnClick="OnDeleteOwn"><span data-wrap-ok>Delete serving: @Chosen!.Label</span></AppButton>
                        }
                    }
                </section>
                <section class="section">
                    <Text Variant="TextVariant.Label" As="TextElement.H2">Meal</Text>
                    <FilterChips TValue="Meal" Label="Meal" Options="Meals" Value="Meal" ValueChanged="OnMealChanged" TestId="serving-meal" />
                    @if (SuggestedAt is { } at && !Editing)
                    {
                        <Shields.UI.Components.Layout.Text Variant="TextVariant.Muted" As="TextElement.P" TestId="serving-suggestion">Suggested from the time: @at.ToString("HH:mm", CultureInfo.InvariantCulture)</Shields.UI.Components.Layout.Text>
                    }
                </section>
                @if (Valid)
                {
                    <Card Title="@(Editing ? "This entry" : "This adds")" TestId="serving-adds">
                        <Text Variant="TextVariant.Figure" As="TextElement.P" TestId="serving-adds-kcal">@Kcal(food) kcal</Text>
                        <Text Variant="TextVariant.Muted" As="TextElement.P" TestId="serving-adds-detail" data-wrap-ok>@AddsDetail(food)</Text>
                    </Card>
                }
            </div>
        }
    </ChildContent>
    <BottomBar>
        @if (Food is not null && !Loading && !LoadFailed)
        {
            @if (Editing)
            {
                <AppButton FullWidth Busy="Saving" Disabled="!Valid || EntryGone || Removing" TestId="serving-save" OnClick="OnSave">@(Saving ? "Saving…" : "Save")</AppButton>
            }
            else
            {
                <AppButton FullWidth Busy="Saving" Disabled="!Valid || Removing" TestId="serving-add" OnClick="OnAdd">@(Saving ? "Adding…" : $"Add to {Meal}")</AppButton>
            }
        }
    </BottomBar>
    <Status>
        @if (EntryGone)
        {
            <div class="status-error"><InlineAlert Message="This entry was already removed." TestId="serving-gone" /></div>
        }
        else if (RemoveFailed)
        {
            <div class="status-error"><InlineAlert Message="Couldn't remove this entry. Try again." TestId="serving-error" /></div>
        }
        else if (SaveFailed)
        {
            <div class="status-error"><InlineAlert Message="@(Editing ? "Couldn't save this entry. Try again." : "Couldn't add this food. Try again.")" TestId="serving-error" /></div>
        }
        <Snackbar />
    </Status>
</AppScreen>

@code {
    private FoodDisplay? Display { get; set; }

    protected override void OnParametersSet() => Display = Food is null ? null : FoodDisplay.Of(Food);

    /// <summary>The food to add, with its values per 100 g or ml. Null shows "Food not found" unless <see cref="Loading"/> or <see cref="LoadFailed"/> is set.</summary>
    [Parameter]
    public Food? Food { get; set; }

    /// <summary>Whether the food is a favourite: the star in the top bar is filled when true, outlined when false. Null shows no star, such as when the read failed.</summary>
    [Parameter]
    public bool? Favourite { get; set; }

    /// <summary>Raised by the star. The screen flips <see cref="Favourite"/> itself; a failed write puts it back.</summary>
    [Parameter]
    public EventCallback OnToggleFavourite { get; set; }

    /// <summary>Shows a spinner instead of the food.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Shows a load error with Try again instead of the food.</summary>
    [Parameter]
    public bool LoadFailed { get; set; }

    /// <summary>The food's servings in listing order (product, packs, the person's own). Empty shows no Enter as switch. Two or more show a list to choose which one Servings counts.</summary>
    [Parameter]
    public IReadOnlyList<Serving> Servings { get; set; } = [];

    /// <summary>Id of the serving Servings counts and "= N g" and Add use. Null, or an id not in <see cref="Servings"/>, means the first.</summary>
    [Parameter]
    public int? ServingId { get; set; }

    /// <summary>Raised with the id of the serving picked in the list.</summary>
    [Parameter]
    public EventCallback<int> OnServingChanged { get; set; }

    /// <summary>Shows the form for the person's own serving instead of the Add your own serving button.</summary>
    [Parameter]
    public bool AddingOwn { get; set; }

    /// <summary>The name typed in the own-serving form.</summary>
    [Parameter]
    public string? OwnLabel { get; set; }

    /// <summary>The size typed in the own-serving form, in g or ml. Null when empty or not a number.</summary>
    [Parameter]
    public decimal? OwnAmount { get; set; }

    /// <summary>An error from saving the own serving (a repeat size, or a failed save), shown in the form.</summary>
    [Parameter]
    public string? OwnError { get; set; }

    /// <summary>Shows Save serving as busy while the serving is saved.</summary>
    [Parameter]
    public bool SavingOwn { get; set; }

    /// <summary>Raised by Add your own serving.</summary>
    [Parameter]
    public EventCallback OnOwnOpen { get; set; }

    /// <summary>Raised on every keystroke in the name field.</summary>
    [Parameter]
    public EventCallback<string> OnOwnLabelChanged { get; set; }

    /// <summary>Raised on every change of the size field with the number (null when it isn't one).</summary>
    [Parameter]
    public EventCallback<decimal?> OnOwnAmountChanged { get; set; }

    /// <summary>Raised by Save serving while the name and size are valid.</summary>
    [Parameter]
    public EventCallback OnOwnSave { get; set; }

    /// <summary>Raised by Cancel in the own-serving form.</summary>
    [Parameter]
    public EventCallback OnOwnCancel { get; set; }

    /// <summary>Raised by Delete serving, shown while a serving the person made is the chosen one.</summary>
    [Parameter]
    public EventCallback OnDeleteOwn { get; set; }

    /// <summary>Grams (or ml) or servings. Ignored, and Grams used, when the food has no serving.</summary>
    [Parameter]
    public EntryMode Mode { get; set; } = EntryMode.Servings;

    /// <summary>The number in the amount field: grams or ml in <see cref="EntryMode.Grams"/>, a count of servings in <see cref="EntryMode.Servings"/>. Null when empty or not a number.</summary>
    [Parameter]
    public decimal? Amount { get; set; }

    /// <summary>The weight (g or ml) the amount comes to, which Add saves and This adds works from. Null, zero, negative or above <see cref="DiaryService.MaxAmount"/> shows the error and disables Add.</summary>
    [Parameter]
    public double? Grams { get; set; }

    /// <summary>The chosen meal chip, named on the Add button.</summary>
    [Parameter]
    public Meal Meal { get; set; }

    /// <summary>The local time the meal was suggested from. Null (the meal was chosen, not suggested) shows no suggestion line.</summary>
    [Parameter]
    public TimeOnly? SuggestedAt { get; set; }

    /// <summary>Shows Add as busy while the entry is saved.</summary>
    [Parameter]
    public bool Saving { get; set; }

    /// <summary>Disables Save and Add while the entry is removed.</summary>
    [Parameter]
    public bool Removing { get; set; }

    /// <summary>Shows the save error above the Add button.</summary>
    [Parameter]
    public bool SaveFailed { get; set; }

    /// <summary>Raised with the mode tapped in Enter as.</summary>
    [Parameter]
    public EventCallback<EntryMode> OnModeChanged { get; set; }

    /// <summary>Raised on every change of the amount field with the number (null when it isn't one).</summary>
    [Parameter]
    public EventCallback<decimal?> OnAmountChanged { get; set; }

    /// <summary>Raised by Use serving, which is shown in grams mode when the food has a serving.</summary>
    [Parameter]
    public EventCallback OnUseServing { get; set; }

    /// <summary>Raised with the meal chip tapped.</summary>
    [Parameter]
    public EventCallback<Meal> OnMealChanged { get; set; }

    /// <summary>Raised by Add while the amount is valid.</summary>
    [Parameter]
    public EventCallback OnAdd { get; set; }

    /// <summary>Changes an existing entry instead of adding one: the trash icon, the day and meal line and Save replace Add, and This entry replaces This adds.</summary>
    [Parameter]
    public bool Editing { get; set; }

    /// <summary>The entry's day, shown with its meal in edit mode.</summary>
    [Parameter]
    public DateOnly Date { get; set; }

    /// <summary>Shows the remove error in edit mode.</summary>
    [Parameter]
    public bool RemoveFailed { get; set; }

    /// <summary>The entry no longer exists (removed elsewhere): says so, and turns Save off.</summary>
    [Parameter]
    public bool EntryGone { get; set; }

    /// <summary>Raised by Save in edit mode while the amount is valid.</summary>
    [Parameter]
    public EventCallback OnSave { get; set; }

    /// <summary>Raised by the trash icon in edit mode.</summary>
    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>Raised by Try again on a load error.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    private static readonly IReadOnlyList<RadioOption<EntryMode>> Modes =
    [
        new(EntryMode.Grams, "Grams", "serving-mode-grams"),
        new(EntryMode.Servings, "Servings", "serving-mode-servings"),
    ];

    private static readonly IReadOnlyList<RadioOption<Meal>> Meals =
    [
        new(Meal.Breakfast, "Breakfast", "serving-meal-breakfast"),
        new(Meal.Lunch, "Lunch", "serving-meal-lunch"),
        new(Meal.Dinner, "Dinner", "serving-meal-dinner"),
        new(Meal.Snacks, "Snacks", "serving-meal-snacks"),
    ];

    /// <summary>The serving switch shows only when the food has a serving.</summary>
    private bool HasServing => ServingRules.HasServing(Servings);

    private Serving? Chosen => ServingRules.Pick(Servings, ServingId);

    private IReadOnlyList<RadioOption<int>> ServingOptions => Servings.Select(x => new RadioOption<int>(x.Id, x.Label, $"serving-option-{x.Id}")).ToList();

    private bool OwnValid => FoodService.TryBoundServing(OwnLabel, (double?)OwnAmount, out _, out _);

    private string? OwnLabelMessage => ServingRules.OwnLabelMessage(OwnLabel);

    private string? OwnAmountMessage(Food food) => ServingRules.OwnAmountMessage(OwnAmount, UnitText(food));

    private bool Valid => ServingRules.IsValidGrams(Grams);

    private static string UnitText(Food food) => food.Unit == FoodUnit.Millilitre ? "ml" : "g";

    private string? InvalidMessage(Food food, bool servings)
    {
        if (Valid)
        {
            return null;
        }

        return Grams is > DiaryService.MaxAmount
            ? servings
                ? $"That is over {DiaryService.MaxAmount.ToString("N0", CultureInfo.InvariantCulture)} {UnitText(food)}. Enter fewer servings."
                : $"Enter an amount of {DiaryService.MaxAmount.ToString("N0", CultureInfo.InvariantCulture)} {UnitText(food)} or less."
            : "Enter an amount above 0.";
    }

    private string PerLine(Food food) =>
        HasServing
            ? $"Per 100 {UnitText(food)} · {Number(food.Kcal)} kcal"
            : $"Per 100 {UnitText(food)} · {Number(food.Kcal)} kcal · P {Number(food.ProteinG)} · C {Number(food.CarbsG)} · F {Number(food.FatG)}";

    private string AddsDetail(Food food) =>
        HasServing
            ? $"{Weight(Grams!.Value)} {UnitText(food)} of {Display?.Title}"
            : $"Protein {Number(Share(food.ProteinG))} g · Carbs {Number(Share(food.CarbsG))} g · Fat {Number(Share(food.FatG))} g";

    private double Share(double per100) => per100 * Grams!.Value / 100;

    private string Kcal(Food food) => Math.Round(Share(food.Kcal), MidpointRounding.AwayFromZero).ToString("0", CultureInfo.InvariantCulture);

    /// <summary>Whole above 100, otherwise one decimal at most.</summary>
    private static string Weight(double grams) => grams >= 100 ? Math.Round(grams, MidpointRounding.AwayFromZero).ToString("0", CultureInfo.InvariantCulture) : Number(grams);

    private static string Number(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
