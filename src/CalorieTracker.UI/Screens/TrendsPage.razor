@using CalorieTracker.Core.Diary
@using CalorieTracker.Core.Foods
@using CalorieTracker.Core.History
@using CalorieTracker.Core.Trends
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject TrendsService Trends
@inject DiaryService Diary
@inject FoodHistoryService History
@inject FoodService Foods
@inject SnackbarService Snackbar
@inject ILogger<TrendsPage> Logger
@inject TimeProvider Time
@inject NavigationManager Navigation

<TrendsView Period="period" Start="start" Today="Today()" Report="report" Loading="loading" LoadFailed="loadFailed"
            OnPeriodChanged="SwitchAsync" OnPrevious="@(() => ShowAsync(period, TrendsRoute.Step(period, start, -1)))" OnNext="NextAsync"
            OnSelectDay="OpenDayAsync" OnSelectWeek="@(day => OpenAsync(TrendsPeriod.Week, day))" OnSelectMonth="@(day => OpenAsync(TrendsPeriod.Month, day))"
            OnRetry="ReloadAsync" OnNavigate="OnNavigate" OnSettings="OnSettings"
            UsualFoods="feed.Usual" UsualAddError="@feed.AddError" OnMealChanged="feed.LoadAsync" OnAddUsual="feed.AddAsync" OnAdd="OnAdd" OnScan="OnScan" />

@code {
    private TrendsPeriod period;
    private DateOnly start;
    private TrendsReport? report;
    private bool loading = true;
    private bool loadFailed;
    private bool opened;
    private bool disposed;
    private int reads;
    private (TrendsPeriod Period, DateOnly? From) openedWith;
    private UsualFoodsFeed feed = null!;

    /// <summary>The span to open on, from the route's <c>period</c>. Week when unset. A change opens that span.</summary>
    [Parameter]
    public TrendsPeriod Period { get; set; }

    /// <summary>A day of the span to open on, from the route's <c>from</c>. Null opens the current span. A change opens that span.</summary>
    [Parameter]
    public DateOnly? From { get; set; }

    /// <summary>Raised with the day when a day's bar or calendar cell is tapped.</summary>
    [Parameter]
    public EventCallback<DateOnly> OnOpenDay { get; set; }

    /// <summary>Raised with the meal and today when the Add sheet's Search foods is tapped.</summary>
    [Parameter]
    public EventCallback<MealAddRequest> OnAdd { get; set; }

    /// <summary>Raised with the meal and today when the Add sheet's Scan barcode is tapped.</summary>
    [Parameter]
    public EventCallback<MealAddRequest> OnScan { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, and with the start destination on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    /// <summary>Raised by the Settings gear.</summary>
    [Parameter]
    public EventCallback OnSettings { get; set; }

    protected override void OnInitialized()
    {
        feed = new UsualFoodsFeed(History, Foods, Diary, Snackbar, Logger, StateHasChanged);
        Diary.Changed += OnDiaryChanged;
    }

    public void Dispose()
    {
        disposed = true;
        feed.Dispose();
        Diary.Changed -= OnDiaryChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        // No read yet means the first render; after that only a new route value reopens a span.
        if (opened && openedWith == (Period, From))
        {
            return;
        }

        opened = true;
        openedWith = (Period, From);
        await ShowAsync(Period, TrendsRoute.Start(Period, TrendsRoute.ClampFrom(From, Today()) ?? Today()), rewriteRoute: false);
    }

    /// <summary>Today by the clock now, so the screen is right when it is used past midnight.</summary>
    private DateOnly Today() => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    /// <summary>The span of the other kind that holds the day the shown one starts on, or today when the shown one is the current one.</summary>
    private Task SwitchAsync(TrendsPeriod next)
    {
        var anchor = TrendsRoute.IsCurrent(period, start, Today()) ? Today() : start;
        return ShowAsync(next, TrendsRoute.Start(next, anchor));
    }

    /// <summary>The next span, unless the shown one is the current one: Next stops there.</summary>
    private Task NextAsync()
    {
        return TrendsRoute.IsCurrent(period, start, Today()) ? Task.CompletedTask : ShowAsync(period, TrendsRoute.Step(period, start, 1));
    }

    private Task OpenAsync(TrendsPeriod next, DateOnly day)
    {
        Log.Opened(Logger, next.ToString().ToLowerInvariant(), period);
        return ShowAsync(next, TrendsRoute.Start(next, day));
    }

    private Task OpenDayAsync(DateOnly day)
    {
        Log.Opened(Logger, "day", period);
        return OnOpenDay.InvokeAsync(day);
    }

    /// <param name="rewriteRoute">Put the span in the address, replacing the entry, so coming back to the screen shows it again. False when the address is where the span came from.</param>
    private Task ShowAsync(TrendsPeriod next, DateOnly first, bool rewriteRoute = true)
    {
        period = next;
        start = first;
        if (rewriteRoute)
        {
            // Set first: the address change comes back as the Period and From parameters and must not read again.
            openedWith = (next, first);
            Navigation.NavigateTo(TrendsRoute.Url(next, first), replace: true);
        }

        return LoadAsync(blank: true);
    }

    private Task ReloadAsync() => LoadAsync(blank: true);

    /// <param name="blank">Show the spinner while reading. False keeps the span on screen until the new read lands, for a change made elsewhere.</param>
    private async Task LoadAsync(bool blank)
    {
        var (shown, first) = (period, start);
        var read = ++reads;
        if (blank)
        {
            loading = true;
            loadFailed = false;
            report = null;
        }

        var result = await Trends.GetAsync(first, TrendsRoute.End(shown, first), Today());
        if (read != reads || disposed)
        {
            return;
        }

        loading = false;
        loadFailed = result.Status != TrendsStatus.Ok;
        report = result.Report;
        if (result.Report is { } days)
        {
            Log.Loaded(Logger, shown, days.Days.Count);
        }
        else
        {
            Log.LoadFailed(Logger, shown);
        }
    }

    /// <summary>An entry was added, changed, removed or restored: read the span again.</summary>
    private void OnDiaryChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed)
        {
            return;
        }

        await LoadAsync(blank: false);
        if (!disposed)
        {
            StateHasChanged();
        }
    });
}
