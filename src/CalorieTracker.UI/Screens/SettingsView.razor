@using Shields.UI.Theme
<AppScreen Title="Settings" OnBack="OnBack">
    <div class="body">
        <section class="section">
            <Typography Variant="TextVariant.Label" As="TextElement.H2">Appearance</Typography>
            <SegmentedControl TValue="ThemePreference" Label="Theme" Options="Themes" Value="Theme" ValueChanged="OnThemeChanged" TestId="theme" />
        </section>
        <section class="section">
            <Typography Variant="TextVariant.Label" As="TextElement.H2">Daily target</Typography>
            <NumberField Label="Calories per day" Unit="kcal" AllowDecimal="false" Value="Target" ValueChanged="OnTargetChanged" TextChanged="OnTargetTextChanged" InvalidMessage="@TargetInvalidMessage" TestId="settings-target" />
            @if (string.IsNullOrEmpty(TargetInvalidMessage))
            {
                <Typography Variant="TextVariant.MutedSmall" As="TextElement.P" TestId="settings-target-hint" data-wrap-ok>Shown on the dashboard. Leave it empty for no target.</Typography>
            }
        </section>
        @if (Version is not null)
        {
            <div class="version"><Typography Variant="TextVariant.MutedSmall" As="TextElement.P" TestId="app-version">Version @Version</Typography></div>
        }
    </div>
</AppScreen>

@code {
    /// <summary>The chosen theme, shown selected in Appearance. System follows the phone.</summary>
    [Parameter]
    public ThemePreference Theme { get; set; }

    /// <summary>The installed app version, shown at the bottom as "Version 1.4.2". Null shows nothing.</summary>
    [Parameter]
    public string? Version { get; set; }

    /// <summary>Raised with the theme tapped in Appearance.</summary>
    [Parameter]
    public EventCallback<ThemePreference> OnThemeChanged { get; set; }

    /// <summary>What the Daily target field shows, in kcal. Null is an empty field, meaning no target.</summary>
    [Parameter]
    public decimal? Target { get; set; }

    /// <summary>Shown in the error tone under the Daily target field in place of the helper text. Null or empty means the field is valid.</summary>
    [Parameter]
    public string? TargetInvalidMessage { get; set; }

    /// <summary>Raised on every change to the Daily target field with its number; null when it was emptied or holds text that isn't a number.</summary>
    [Parameter]
    public EventCallback<decimal?> OnTargetChanged { get; set; }

    /// <summary>Raised on every keystroke in the Daily target field with the typed text, just before <see cref="OnTargetChanged"/>.</summary>
    [Parameter]
    public EventCallback<string> OnTargetTextChanged { get; set; }

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    private static readonly IReadOnlyList<RadioOption<ThemePreference>> Themes =
    [
        new(ThemePreference.System, "System", "settings-theme-system"),
        new(ThemePreference.Light, "Light", "settings-theme-light"),
        new(ThemePreference.Dark, "Dark", "settings-theme-dark"),
    ];
}
