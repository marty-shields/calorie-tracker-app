@using CalorieTracker.UI.Models.Scan
<ScanView State="state" Product="product" OnScanAgain="RunScanAsync" OnAddToDiary="AddToDiaryAsync" OnSearchByName="OnSearchByName" OnBack="OnBack" />

@code {
    /// <summary>Raised by the back arrow, Android back, and when the camera is closed without a barcode.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Raised with the id of the scanned food when Add to diary is tapped.</summary>
    [Parameter]
    public EventCallback<ScanAddRequest> OnAddToDiary { get; set; }

    /// <summary>Raised by Search by name, shown when the product has no food id to add.</summary>
    [Parameter]
    public EventCallback OnSearchByName { get; set; }
}
