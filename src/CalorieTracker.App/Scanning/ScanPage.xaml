<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:scan="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             x:Class="CalorieTracker.App.Scanning.ScanPage">

    <Grid RowDefinitions="*,Auto">
        <scan:CameraView x:Name="Camera"
                         HandlerProperties.DisconnectPolicy="Manual"
                         BarcodeSymbologies="Ean13, Ean8, Upca"
                         OnDetectionFinished="OnDetectionFinished" />
        <Border AutomationId="scan-native-frame"
                AutomationProperties.IsInAccessibleTree="False"
                InputTransparent="True"
                WidthRequest="280"
                HeightRequest="140"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Stroke="{StaticResource Text}"
                StrokeThickness="3"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="Transparent" />
        <Label AutomationId="scan-native-hint"
               Text="Point the camera at a barcode"
               InputTransparent="True"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="16"
               Padding="16,8"
               FontSize="16"
               TextColor="{StaticResource Text}"
               BackgroundColor="{StaticResource Scrim}" />
        <Grid Grid.Row="1" Padding="16"
              BackgroundColor="{StaticResource Background}">
            <Button AutomationId="scan-native-cancel"
                    Text="Cancel"
                    Clicked="OnCancelClicked"
                    HeightRequest="48"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    BorderWidth="1"
                    BorderColor="{StaticResource BorderStrong}"
                    TextColor="{StaticResource Text}" />
        </Grid>
    </Grid>

</ContentPage>
