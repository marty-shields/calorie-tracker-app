<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieTracker.App.App">
    <Application.Resources>
        <!-- Mirrors the UI project's tokens.css (light and dark) for the native camera page. -->
        <Color x:Key="BackgroundLight">#f4f8f8</Color>
        <Color x:Key="BackgroundDark">#141819</Color>
        <Color x:Key="TextLight">#373e40</Color>
        <Color x:Key="TextDark">#e4ecec</Color>
        <Color x:Key="BorderStrongLight">#77878b</Color>
        <Color x:Key="BorderStrongDark">#7f9093</Color>
        <Color x:Key="OverlayText">#ffffff</Color>
        <Color x:Key="Scrim">#99000000</Color>
    </Application.Resources>
</Application>
