<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieTracker.App.App">
    <Application.Resources>
        <!-- The dark values of tokens.css for the native camera page, which is always dark: the app's theme choice lives in the web view. -->
        <Color x:Key="Background">#141819</Color>
        <Color x:Key="Text">#e4ecec</Color>
        <Color x:Key="BorderStrong">#7f9093</Color>
        <Color x:Key="Scrim">#99000000</Color>
    </Application.Resources>
</Application>
