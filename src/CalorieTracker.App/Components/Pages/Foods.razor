@page "/foods"
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Diary
@using CalorieTracker.UI.Navigation
@using CalorieTracker.UI.Screens
@inject NavigationManager Navigation
@inject TimeProvider Time

@* Back goes to the Dashboard (on the day in date).
   Query: meal and date (yyyy-MM-dd, default today) open search to add to that meal, q restores a search (an old type value is ignored).
   Without a meal (an old link) the meal is the one the time of day suggests (MealWindows).
   A result opens Serving with that meal, and Add goes on to the Dashboard (on that day when a date is given). The barcode button opens the scanner for the same meal and day, and its Back returns here. *@
<FoodSearchPage Meal="meal" InitialQuery="@Query"
                OnAdd="Add" OnBack="@(() => Navigation.GoTo(date is { } day ? DashboardRoute.Url(day) : "/"))"
                OnScan="@(typed => Navigation.GoTo(ScanRoute.AddUrl(meal, date, FoodSearchRoute.AddUrl(meal, date, typed))))" />

@code {
    [SupplyParameterFromQuery(Name = "meal")]
    public string? MealText { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? DateText { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private Meal meal;

    private DateOnly? date;

    /// <summary>Works the meal out once per set of route values, so a clock that crosses a meal window never changes it between renders.</summary>
    protected override void OnParametersSet()
    {
        meal = ServingRoute.ParseMeal(MealText) ?? MealWindows.MealFor(TimeOnly.FromDateTime(Time.GetLocalNow().DateTime));
        date = RouteDate.Parse(DateText);
    }

    private void Add(FoodAddRequest request) =>
        Navigation.GoTo(ServingRoute.Url(request.Food.Id, meal, date, backTo: FoodSearchRoute.AddUrl(meal, date, request.Query), amount: request.LastAmount, servings: request.LastServings, servingId: request.LastServingId));
}
