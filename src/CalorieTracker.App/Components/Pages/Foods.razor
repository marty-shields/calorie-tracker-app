@page "/foods"
@using System.Globalization
@using CalorieTracker.Core.Data
@using CalorieTracker.UI.Navigation
@using CalorieTracker.UI.Screens
@inject NavigationManager Navigation

@* Back goes to the Dashboard (or from a food's values, to the list); AppScreen does both.
   Query: meal and date (yyyy-MM-dd, default today) open search to add to that meal, q and type restore a search.
   A meal's + sends a person here with a meal: a result opens Serving with that meal, and Add goes on to the Dashboard.
   From the Foods tab a food's Add to diary opens Serving with a suggested meal, and Add comes back to this search. *@
<FoodSearchPage Meal="meal" InitialQuery="Query" InitialFilter="FoodSearchRoute.ParseFilter(TypeText)"
                OnAdd="Add" OnBack="@(() => Navigation.GoTo("/"))" OnNavigate="@(destination => Navigation.GoTo(destination))" />

@code {
    [SupplyParameterFromQuery(Name = "meal")]
    public string? MealText { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? DateText { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeText { get; set; }

    private Meal? meal => ServingRoute.ParseMeal(MealText);

    private DateOnly? date => DateOnly.TryParseExact(DateText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed) ? parsed : null;

    private void Add(FoodAddRequest request) =>
        Navigation.GoTo(meal is { } preset
            ? ServingRoute.Url(request.Food.Id, preset, date, backTo: FoodSearchRoute.AddUrl(preset, date))
            : ServingRoute.Url(request.Food.Id, returnTo: FoodSearchRoute.Url(request.Query, request.Filter)));
}
