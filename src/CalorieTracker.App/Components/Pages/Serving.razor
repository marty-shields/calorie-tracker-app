@page "/serving/{FoodId:int}"
@using CalorieTracker.UI.Navigation
@using CalorieTracker.UI.Screens
@inject NavigationManager Navigation
@inject TimeProvider Time

@* Query: entry (an entry's id: edit mode, with amount and servings as the entry holds them; Back, Save and Remove then go to the day's Dashboard), meal (preset), date (yyyy-MM-dd, default today), amount, servings and serving without entry (the amount to open with, such as what was last logged), back (an in-app route for Back). *@
<ServingPage FoodId="FoodId" Meal="ServingRoute.ParseMeal(MealText)" Date="EntryId is null ? ServingRoute.ParseDate(DateText, Today) : RouteDate.Parse(DateText) ?? default"
             EntryId="EntryId" EntryAmount="ServingRoute.ParseNumber(AmountText)" EntryServings="ServingRoute.ParseNumber(ServingsText)" EntryServingId="ServingRoute.ParseId(ServingText)"
             StartAmount="EntryId is null ? ServingRoute.ParseNumber(AmountText) : null" StartServings="EntryId is null ? ServingRoute.ParseNumber(ServingsText) : null" StartServingId="EntryId is null ? ServingRoute.ParseId(ServingText) : null"
             OnSaved="@(() => Navigation.GoTo(DashboardRoute.Url(EntryDay)))"
             OnRemoved="@(() => Navigation.GoTo(DashboardRoute.Url(EntryDay)))"
             OnBack="@(() => Navigation.GoTo(EntryId is null ? ServingRoute.BackTarget(BackTo) : DashboardRoute.Url(EntryDay)))"
             OnAdded="@(meal => Navigation.GoTo(ServingRoute.AfterAddTarget(RouteDate.Parse(DateText), meal)))" />

@code {
    [Parameter]
    public int FoodId { get; set; }

    [SupplyParameterFromQuery(Name = "entry")]
    public int? EntryId { get; set; }

    [SupplyParameterFromQuery(Name = "amount")]
    public string? AmountText { get; set; }

    [SupplyParameterFromQuery(Name = "servings")]
    public string? ServingsText { get; set; }

    [SupplyParameterFromQuery(Name = "serving")]
    public string? ServingText { get; set; }

    [SupplyParameterFromQuery(Name = "meal")]
    public string? MealText { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? DateText { get; set; }

    [SupplyParameterFromQuery(Name = "back")]
    public string? BackTo { get; set; }

    /// <summary>The entry's day, or today when the route names none, for where Back, Save and Remove go in edit mode.</summary>
    private DateOnly EntryDay => ServingRoute.ParseDate(DateText, Today);

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
}
