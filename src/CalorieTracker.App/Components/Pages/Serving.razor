@page "/serving/{FoodId:int}"
@using CalorieTracker.UI.Navigation
@using CalorieTracker.UI.Screens
@inject NavigationManager Navigation
@inject TimeProvider Time

@* Query: entry (an entry's id: edit mode, with amount and servings as the entry holds them; Back, Save and Remove then go to the day's Dashboard), meal (preset), date (yyyy-MM-dd, default today), return (an in-app route for Back and a saved entry), back (an in-app route for Back alone). *@
<ServingPage FoodId="FoodId" Meal="ServingRoute.ParseMeal(MealText)" Date="ServingRoute.ParseDate(DateText, Today)"
             EntryId="EntryId" EntryAmount="ServingRoute.ParseNumber(AmountText)" EntryServings="ServingRoute.ParseNumber(ServingsText)"
             OnSaved="@(() => Navigation.GoTo(ServingRoute.EditTarget(ServingRoute.ParseDate(DateText, Today))))"
             OnRemoved="@(() => Navigation.GoTo(ServingRoute.EditTarget(ServingRoute.ParseDate(DateText, Today))))"
             AfterAdd="ServingRoute.FollowUpFor(ReturnTo)"
             ViewDay="@(day => { Navigation.GoTo(DashboardRoute.Url(day)); return Task.CompletedTask; })"
             OnBack="@(() => Navigation.GoTo(EntryId is null ? ServingRoute.BackTarget(BackTo, ReturnTo) : ServingRoute.EditTarget(ServingRoute.ParseDate(DateText, Today))))"
             OnAdded="@(() => Navigation.GoTo(ServingRoute.AfterAddTarget(ReturnTo, RouteDate.Parse(DateText))))" />

@code {
    [Parameter]
    public int FoodId { get; set; }

    [SupplyParameterFromQuery(Name = "entry")]
    public int? EntryId { get; set; }

    [SupplyParameterFromQuery(Name = "amount")]
    public string? AmountText { get; set; }

    [SupplyParameterFromQuery(Name = "servings")]
    public string? ServingsText { get; set; }

    [SupplyParameterFromQuery(Name = "meal")]
    public string? MealText { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? DateText { get; set; }

    [SupplyParameterFromQuery(Name = "return")]
    public string? ReturnTo { get; set; }

    [SupplyParameterFromQuery(Name = "back")]
    public string? BackTo { get; set; }

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
}
