@page "/serving/{FoodId:int}"
@using CalorieTracker.UI.Navigation
@using CalorieTracker.UI.Screens
@inject NavigationManager Navigation
@inject TimeProvider Time

@* Query: meal (preset), date (yyyy-MM-dd, default today), return (an in-app route for Back and a saved entry), back (an in-app route for Back alone). *@
<ServingPage FoodId="FoodId" Meal="ServingRoute.ParseMeal(MealText)" Date="ServingRoute.ParseDate(DateText, Today)"
             AfterAdd="ServingRoute.FollowUpFor(ReturnTo)"
             ViewDay="@(day => { Navigation.GoTo(DashboardRoute.Url(day)); return Task.CompletedTask; })"
             OnBack="@(() => Navigation.GoTo(ServingRoute.BackTarget(BackTo, ReturnTo)))"
             OnAdded="@(() => Navigation.GoTo(ServingRoute.AfterAddTarget(ReturnTo)))" />

@code {
    [Parameter]
    public int FoodId { get; set; }

    [SupplyParameterFromQuery(Name = "meal")]
    public string? MealText { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? DateText { get; set; }

    [SupplyParameterFromQuery(Name = "return")]
    public string? ReturnTo { get; set; }

    [SupplyParameterFromQuery(Name = "back")]
    public string? BackTo { get; set; }

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
}
