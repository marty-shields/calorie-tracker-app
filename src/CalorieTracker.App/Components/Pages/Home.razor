@page "/"
@using CalorieTracker.Core.Data
@using CalorieTracker.UI.Navigation
@using CalorieTracker.UI.Screens
@inject NavigationManager Navigation

@* Back has no handler here, so it leaves the app. Query: date (yyyy-MM-dd) opens that day; without it the Dashboard opens on today.
   A meal's + and the bar's Add sheet (Search foods) open search to add to that meal and day, the sheet's Scan barcode opens the scanner the same way; an entry opens Serving in edit mode. *@
<DashboardPage Date="date"
               OnAdd="@(request => Navigation.GoTo(FoodSearchRoute.AddUrl(request.Meal, request.Date)))"
               OnScan="@(request => Navigation.GoTo(ScanRoute.AddUrl(request.Meal, request.Date)))"
               OnEdit="@(request => Navigation.GoTo(ServingRoute.EditUrl(request.Entry.EntryId, request.Entry.FoodId, request.Meal, request.Date, request.Entry.Amount, request.Entry.Servings, request.Entry.ServingId)))"
               OnNavigate="@(destination => Navigation.GoTo(destination))"
               OnSettings="@(day => Navigation.GoTo(SettingsRoute.Url(DashboardRoute.Url(day))))" />

@code {
    [SupplyParameterFromQuery(Name = "date")]
    public string? DateText { get; set; }

    private DateOnly? date => RouteDate.Parse(DateText);
}
