@page "/scan"
@using CalorieTracker.UI.Navigation
@using CalorieTracker.UI.Screens
@inject NavigationManager Navigation

<ScanPage OnAddToDiary="@(add => Navigation.GoTo(ServingRoute.Url(add.FoodId, backTo: "/")))"
          OnBack="@(() => Navigation.GoTo(string.Empty))"
          OnNavigate="@(destination => Navigation.GoTo(destination))" />
