@page "/scan"
@using CalorieTracker.Core.Data
@using CalorieTracker.UI.Navigation
@using CalorieTracker.UI.Screens
@inject NavigationManager Navigation

@* Query: meal and date (yyyy-MM-dd, default today) come from the Add sheet. With a meal, a scanned food opens Serving with that meal and day, Search by name opens search to add to it, and Back goes to the Dashboard on that day. *@
<ScanPage Meal="meal" OnAddToDiary="@(add => Navigation.GoTo(ServingRoute.Url(add.FoodId, meal, date, backTo: date is { } day ? DashboardRoute.Url(day) : "/", amount: add.LastAmount, servings: add.LastServings, servingId: add.LastServingId)))"
          OnBack="@(() => Navigation.GoTo(date is { } day ? DashboardRoute.Url(day) : string.Empty))"
          OnSearchByName="@(() => Navigation.GoTo(meal is { } preset ? FoodSearchRoute.AddUrl(preset, date) : FoodSearchRoute.Template))" />

@code {
    [SupplyParameterFromQuery(Name = "meal")]
    public string? MealText { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? DateText { get; set; }

    private Meal? meal => ServingRoute.ParseMeal(MealText);

    private DateOnly? date => RouteDate.Parse(DateText);
}
