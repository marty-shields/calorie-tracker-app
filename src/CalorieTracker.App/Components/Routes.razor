@using Microsoft.AspNetCore.Components.Routing
@using CalorieTracker.Core.Data
@using CalorieTracker.Core.Seed
@using CalorieTracker.UI.Components.Layout
@inject IDatabaseInitializer DatabaseInitializer
@inject ISeedLoader SeedLoader
@inject NavigationManager Navigation

<SystemBarInsets />
<StartupGate Initialize="InitializeAsync">
    <AppErrorBoundary OnRestart="() => Navigation.GoTo(string.Empty)">
        <Router AppAssembly="typeof(MauiProgram).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="routeData" />
            </Found>
        </Router>
    </AppErrorBoundary>
</StartupGate>

@code {
    private async Task InitializeAsync()
    {
        await DatabaseInitializer.InitializeAsync();

        // Not awaited, so the first screen does not wait for the seed. LoadAsync never throws.
        _ = SeedLoader.LoadAsync();
    }
}
