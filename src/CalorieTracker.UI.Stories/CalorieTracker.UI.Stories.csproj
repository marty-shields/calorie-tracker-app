<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <MD2RazorDefaultBaseClass>global::BlazingStory.Internals.Pages.MarkdownPageBase</MD2RazorDefaultBaseClass>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazingStory" />
    <PackageReference Include="MD2RazorGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The kit's stories shell comes from the Shields.UI.Stories package. -p:UseKitSource=true uses a checkout of the kit instead
       (KitPath, see Directory.Build.props); add -p:RestoreLockedMode=false, since the lock files describe the packages. -->
  <ItemGroup Condition="'$(UseKitSource)' != 'true'">
    <PackageReference Include="Shields.UI.Stories" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseKitSource)' == 'true'">
    <ProjectReference Include="$(KitPath)/src/Shields.UI.Stories/Shields.UI.Stories.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CalorieTracker.UI\CalorieTracker.UI.csproj" />
  </ItemGroup>

  <!-- The App's icon and splash, embedded as brand.<file>.svg for the App Icon stories. -->
  <ItemGroup>
    <EmbeddedResource Include="..\CalorieTracker.App\Resources\AppIcon\*.svg;..\CalorieTracker.App\Resources\Splash\*.svg" LogicalName="brand.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
