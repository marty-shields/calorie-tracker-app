            <FoodSearchView Query="oat" Loading OnQueryChanged="(string _) => { }" OnNavigate="(NavDestination _) => { }" />
        </Template>
    </Story>

    <Story Name="Nothing typed">
        <Template>
            <FoodSearchView OnQueryChanged="(string _) => { }" OnNavigate="(NavDestination _) => { }" />
