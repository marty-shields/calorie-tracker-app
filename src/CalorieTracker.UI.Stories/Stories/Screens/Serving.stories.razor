@code {
    private bool posted;

    [Inject]
    private SnackbarService Snackbar { get; set; } = null!;

    /// <summary>Posts what the screen posts after a tap on the star, as the snackbar shows it; it stays until this story is left, so no other story shows it.</summary>
    private void Post(string text, string? action = null)
    {
        if (!posted)
        {
            posted = true;
            Snackbar.Show(text, action, action is null ? null : () => Task.CompletedTask, Timeout.InfiniteTimeSpan);
        }
    }

    public void Dispose()
    {
        if (posted)
        {
            Snackbar.Dismiss();
        }
    }
}
