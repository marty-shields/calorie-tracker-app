@using CalorieTracker.UI.Components.Feedback
@attribute [Stories("Screens/Dashboard")]

<Stories TComponent="DashboardView" Layout="typeof(PhoneLayout)">

    <Story Name="First run">
        <Template>
            @{ Snackbar.Dismiss(); }
            <DashboardView Date="DashboardSamples.Today" Today="DashboardSamples.Today" Summary="DashboardSamples.FirstRun" OnAdd="(MealAddRequest _) => { }" OnEdit="(EntryEditRequest _) => { }" OnSettings="() => { }" OnNavigate="(NavDestination _) => { }" />
        </Template>
    </Story>

    <Story Name="No target">
        <Template>
            @{ Snackbar.Dismiss(); }
            <DashboardView Date="DashboardSamples.Today" Today="DashboardSamples.Today" Summary="DashboardSamples.NoTarget" OnAdd="(MealAddRequest _) => { }" OnEdit="(EntryEditRequest _) => { }" OnSettings="() => { }" OnNavigate="(NavDestination _) => { }" />
        </Template>
    </Story>

    <Story Name="Loaded">
        <Template>
            @{ Snackbar.Dismiss(); }
            <DashboardView Date="DashboardSamples.Today" Today="DashboardSamples.Today" Summary="DashboardSamples.Loaded" OnAdd="(MealAddRequest _) => { }" OnEdit="(EntryEditRequest _) => { }" OnSettings="() => { }" OnNavigate="(NavDestination _) => { }" />
        </Template>
    </Story>

    <Story Name="Over target">
        <Template>
            @{ Snackbar.Dismiss(); }
            <DashboardView Date="DashboardSamples.Today" Today="DashboardSamples.Today" Summary="DashboardSamples.OverTarget" OnAdd="(MealAddRequest _) => { }" OnEdit="(EntryEditRequest _) => { }" OnSettings="() => { }" OnNavigate="(NavDestination _) => { }" />
        </Template>
    </Story>

    <Story Name="Loading">
        <Template>
            @{ Snackbar.Dismiss(); }
            <DashboardView Date="DashboardSamples.Today" Today="DashboardSamples.Today" Loading OnSettings="() => { }" OnNavigate="(NavDestination _) => { }" />
        </Template>
    </Story>

    <Story Name="Load failed">
        <Template>
            @{ Snackbar.Dismiss(); }
            <DashboardView Date="DashboardSamples.Today" Today="DashboardSamples.Today" LoadFailed OnRetry="() => { }" OnSettings="() => { }" OnNavigate="(NavDestination _) => { }" />
        </Template>
    </Story>

    <Story Name="Future day">
        <Template>
            @{ Snackbar.Dismiss(); }
            <DashboardView Date="DashboardSamples.Today.AddDays(1)" Today="DashboardSamples.Today" Summary="DashboardSamples.Loaded" OnAdd="(MealAddRequest _) => { }" OnEdit="(EntryEditRequest _) => { }" OnSettings="() => { }" OnNavigate="(NavDestination _) => { }" />
        </Template>
    </Story>

    <Story Name="Entry removed">
        <Template>
            @{ PostRemoved(); }
            <DashboardView Date="DashboardSamples.Today" Today="DashboardSamples.Today" Summary="DashboardSamples.Loaded" OnAdd="(MealAddRequest _) => { }" OnEdit="(EntryEditRequest _) => { }" OnSettings="() => { }" OnNavigate="(NavDestination _) => { }" />
        </Template>
    </Story>

</Stories>

@code {
    [Inject]
    private SnackbarService Snackbar { get; set; } = null!;

    /// <summary>Posts what the Serving screen posts after Remove, as the Dashboard's snackbar shows it; it stays until dismissed.</summary>
    private void PostRemoved()
    {
        if (Snackbar.Current is null)
        {
            Snackbar.Show("Cheddar cheese removed", "Undo", () => Task.CompletedTask, Timeout.InfiniteTimeSpan);
        }
    }
}
