@using CalorieTracker.Core.Data
@using CalorieTracker.UI.Models.Scan
@attribute [Stories(StoryTitles.Prefix + "Screens/Scan")]

<Stories TComponent="ScanView" Layout="typeof(PhoneLayout)">

    <Story Name="Opening camera">
        <Template>
            <ScanView State="ScanState.OpeningCamera" Meal="Meal.Lunch" Date="DashboardSamples.Today" OnScanAgain="() => { }" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Closing camera">
        <Template>
            <ScanView State="ScanState.Closing" Meal="Meal.Lunch" Date="DashboardSamples.Today" OnScanAgain="() => { }" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Looking up">
        <Template>
            <ScanView State="ScanState.LookingUp" Meal="Meal.Lunch" Date="DashboardSamples.Today" OnScanAgain="() => { }" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Adding to another day">
        <Template>
            <ScanView State="ScanState.LookingUp" Meal="Meal.Dinner" Date="DashboardSamples.Today.AddDays(-6)" OnScanAgain="() => { }" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Not found">
        <Template>
            <ScanView State="ScanState.NotFound" Meal="Meal.Lunch" Date="DashboardSamples.Today" OnSearchByName="() => { }" OnScanAgain="() => { }" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Camera unavailable">
        <Template>
            <ScanView State="ScanState.CameraUnavailable" Meal="Meal.Lunch" Date="DashboardSamples.Today" OnSearchByName="() => { }" OnScanAgain="() => { }" OnBack="() => { }" />
        </Template>
    </Story>

</Stories>
