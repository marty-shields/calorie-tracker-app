@using CalorieTracker.UI.Models.Scan
@attribute [Stories("Screens/Scan")]

<Stories TComponent="ScanView" Layout="typeof(PhoneLayout)">

    <Story Name="Scanning">
        <Template>
            <ScanView State="ScanState.Scanning" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Looking up">
        <Template>
            <ScanView State="ScanState.LookingUp" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Found">
        <Template>
            <ScanView State="ScanState.Found" Product="@(new("Porridge oats", "Morning Mill", 372, 11, 60, 8))" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Found liquid">
        <Template>
            <ScanView State="ScanState.Found" Product="@(new("Semi-skimmed milk", null, 47, 3.5m, 4.8m, 1.7m, IsLiquid: true))" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Found with warning">
        <Template>
            <ScanView State="ScanState.Found" Product="@(new("Chocolate spread", "Nutty Co", 250, 6, 55, 31))" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Not found">
        <Template>
            <ScanView State="ScanState.NotFound" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Camera unavailable">
        <Template>
            <ScanView State="ScanState.CameraUnavailable" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

</Stories>
