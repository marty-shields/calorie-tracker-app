@using CalorieTracker.UI.Models.Scan
@attribute [Stories("Screens/Scan")]

<Stories TComponent="ScanView" Layout="typeof(PhoneLayout)">

    <Story Name="Opening camera">
        <Template>
            <ScanView State="ScanState.OpeningCamera" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Closing camera">
        <Template>
            <ScanView State="ScanState.Closing" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Looking up">
        <Template>
            <ScanView State="ScanState.LookingUp" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Found">
        <Template>
            <ScanView State="ScanState.Found" Product="@(new("Porridge oats", "Morning Mill", 372, 11, 60, 8, FoodId: 1))" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Found liquid">
        <Template>
            <ScanView State="ScanState.Found" Product="@(new("Semi-skimmed milk", null, 47, 3.5m, 4.8m, 1.7m, IsLiquid: true, FoodId: 2))" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Found with extra nutrients">
        <Template>
            <ScanView State="ScanState.Found" Product="@(new("Porridge oats", "Morning Mill", 372, 11, 60, 8, Fibre: 9, Sugars: 1.1m, Saturates: 1.4m, Salt: 0.01m, FoodId: 1))" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Found with a serving">
        <Template>
            <ScanView State="ScanState.Found" Product="@(new("Digestive biscuits", "Morning Mill", 480, 7, 62, 22, FoodId: 3, ServingLabel: "1 biscuit", ServingAmount: 15))" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Found with warning">
        <Template>
            <ScanView State="ScanState.Found" Product="@(new("Chocolate spread", "Nutty Co", 250, 6, 55, 31, FoodId: 4))" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Not found">
        <Template>
            <ScanView State="ScanState.NotFound" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

    <Story Name="Camera unavailable">
        <Template>
            <ScanView State="ScanState.CameraUnavailable" OnNavigate="_ => { }" OnScanAgain="() => { }" />
        </Template>
    </Story>

</Stories>
