@using CalorieTracker.UI.Components.Charts
@attribute [Stories("Components/Charts/CalorieRing")]

<Stories TComponent="CalorieRing" Layout="typeof(ThemeLayout)">

    <Story Name="Empty">
        <Template>
            <CalorieRing Eaten="0" Target="2100" TestId="ring" />
        </Template>
    </Story>

    <Story Name="Partial">
        <Template>
            <CalorieRing Eaten="659" Target="2100" TestId="ring" />
        </Template>
    </Story>

    <Story Name="Exactly at target">
        <Template>
            <CalorieRing Eaten="2100" Target="2100" TestId="ring" />
        </Template>
    </Story>

    <Story Name="Over target">
        <Template>
            <CalorieRing Eaten="2359" Target="2100" TestId="ring" />
        </Template>
    </Story>

    <Story Name="No target">
        <Template>
            <CalorieRing Eaten="659" TestId="ring" />
        </Template>
    </Story>

    <Story Name="Short values">
        <Template>
            <CalorieRing Eaten="2093" Target="2100" TestId="ring" />
            <CalorieRing Eaten="2093" Target="2100" Compact TestId="ring-compact" />
            <CalorieRing Eaten="7" Target="2100" TestId="ring" />
            <CalorieRing Eaten="7" Target="2100" Compact TestId="ring-compact" />
        </Template>
    </Story>

    <Story Name="Long left">
        <Template>
            <CalorieRing Eaten="0" Target="12345" TestId="ring" />
            <CalorieRing Eaten="0" Target="12345" Compact TestId="ring-compact" />
        </Template>
    </Story>

    <Story Name="Long over">
        <Template>
            <CalorieRing Eaten="14445" Target="2100" TestId="ring" />
            <CalorieRing Eaten="14445" Target="2100" Compact TestId="ring-compact" />
        </Template>
    </Story>

    <Story Name="Long eaten">
        <Template>
            <CalorieRing Eaten="12345" TestId="ring" />
            <CalorieRing Eaten="12345" Compact TestId="ring-compact" />
        </Template>
    </Story>

    <Story Name="Longest left">
        <Template>
            <CalorieRing Eaten="0" Target="123456" TestId="ring" />
            <CalorieRing Eaten="0" Target="123456" Compact TestId="ring-compact" />
        </Template>
    </Story>

    <Story Name="Longest over">
        <Template>
            <CalorieRing Eaten="125556" Target="2100" TestId="ring" />
            <CalorieRing Eaten="125556" Target="2100" Compact TestId="ring-compact" />
        </Template>
    </Story>

    <Story Name="Longest eaten">
        <Template>
            <CalorieRing Eaten="123456" TestId="ring" />
            <CalorieRing Eaten="123456" Compact TestId="ring-compact" />
        </Template>
    </Story>

    <Story Name="Four digits">
        <Template>
            <CalorieRing Eaten="1000" Target="2234" TestId="ring" />
            <CalorieRing Eaten="1000" Target="2234" Compact TestId="ring-compact" />
        </Template>
    </Story>

    <Story Name="Widest four digits">
        <Template>
            <CalorieRing Eaten="1000" Target="10999" TestId="ring" />
            <CalorieRing Eaten="1000" Target="10999" Compact TestId="ring-compact" />
        </Template>
    </Story>

</Stories>
