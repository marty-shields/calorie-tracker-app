@using CalorieTracker.UI.Components.Charts
@using CalorieTracker.UI.Stories.Stories.Components.Charts
@attribute [Stories("Components/Charts/MonthCalendar")]

<Stories TComponent="MonthCalendar" Layout="typeof(ThemeLayout)">

    <Story Name="Month in progress">
        <Template>
            <MonthCalendar Month="new DateOnly(2026, 11, 1)" Days="ChartSamples.Month(2026, 11, ChartSamples.Today)" Target="ChartSamples.Target" Today="ChartSamples.Today" OnSelect="_ => { }" TestId="calendar" />
        </Template>
    </Story>

    <Story Name="Finished month starting on Monday">
        <Template>
            <MonthCalendar Month="new DateOnly(2026, 6, 1)" Days="ChartSamples.Month(2026, 6, new DateOnly(2026, 6, 30))" Target="ChartSamples.Target" Today="ChartSamples.Today" OnSelect="_ => { }" TestId="calendar" />
        </Template>
    </Story>

    <Story Name="All over">
        <Template>
            <MonthCalendar Month="new DateOnly(2026, 11, 1)" Days="ChartSamples.AllOver(2026, 11, ChartSamples.Today)" Target="ChartSamples.Target" Today="ChartSamples.Today" OnSelect="_ => { }" TestId="calendar" />
        </Template>
    </Story>

    <Story Name="Nothing logged">
        <Template>
            <MonthCalendar Month="new DateOnly(2026, 11, 1)" Target="ChartSamples.Target" Today="ChartSamples.Today" OnSelect="_ => { }" TestId="calendar" />
        </Template>
    </Story>

    <Story Name="Single day logged">
        <Template>
            <MonthCalendar Month="new DateOnly(2026, 11, 1)" Days="@([new CalendarDay(new DateOnly(2026, 11, 10), 2050)])" Target="ChartSamples.Target" Today="ChartSamples.Today" OnSelect="_ => { }" TestId="calendar" />
        </Template>
    </Story>

</Stories>
