@using CalorieTracker.UI.Components.Charts
@attribute [Stories(StoryTitles.Prefix + "Components/Charts/EnergyShareBar")]

<Stories TComponent="EnergyShareBar" Layout="typeof(ThemeLayout)">

    <Story Name="Balanced">
        <Template>
            <EnergyShareBar Protein="30" Carbs="30" Fat="13" TestId="share" />
        </Template>
    </Story>

    <Story Name="One dominant">
        <Template>
            <EnergyShareBar Protein="12" Carbs="95" Fat="6" TestId="share" />
        </Template>
    </Story>

    <Story Name="All zero">
        <Template>
            <EnergyShareBar TestId="share" />
        </Template>
    </Story>

</Stories>
