@using CalorieTracker.UI.Components.Layout
@attribute [Stories("Components/Layout/AddSheet")]

<Stories TComponent="AddSheet" Layout="typeof(PhoneLayout)">

    <Story Name="With usual foods">
        <Template>
            <AddSheet Open Clock="new FixedTimeProvider(new TimeOnly(19, 30))" Usual="UsualDinner" OnSearch="(Meal _) => { }" OnScan="(Meal _) => { }" OnAddUsual="(UsualAddRequest _) => { }" OnClose="() => { }" />
            <NavScreen Title="Calorie Tracker" Destination="NavDestination.Today" OnNavigate="(NavDestination _) => { }">
                <p>Today</p>
            </NavScreen>
        </Template>
    </Story>

    <Story Name="Without usual foods">
        <Template>
            <AddSheet Open Clock="new FixedTimeProvider(new TimeOnly(19, 30))" Usual="@(Array.Empty<UsualFoodRow>())" OnSearch="(Meal _) => { }" OnScan="(Meal _) => { }" OnClose="() => { }" />
            <NavScreen Title="Calorie Tracker" Destination="NavDestination.Today" OnNavigate="(NavDestination _) => { }">
                <p>Today</p>
            </NavScreen>
        </Template>
    </Story>

    <Story Name="Usual foods could not be read">
        <Template>
            @* A failed read leaves Usual unset, so the section is hidden and Search foods and Scan barcode work as before. *@
            <AddSheet Open Clock="new FixedTimeProvider(new TimeOnly(19, 30))" OnSearch="(Meal _) => { }" OnScan="(Meal _) => { }" OnClose="() => { }" />
            <NavScreen Title="Calorie Tracker" Destination="NavDestination.Today" OnNavigate="(NavDestination _) => { }">
                <p>Today</p>
            </NavScreen>
        </Template>
    </Story>

    <Story Name="Add failed">
        <Template>
            <AddSheet Open Clock="new FixedTimeProvider(new TimeOnly(19, 30))" Usual="UsualDinner" AddError="Couldn't add Chicken curry with rice to Dinner. Try again." OnSearch="(Meal _) => { }" OnScan="(Meal _) => { }" OnAddUsual="(UsualAddRequest _) => { }" OnClose="() => { }" />
            <NavScreen Title="Calorie Tracker" Destination="NavDestination.Today" OnNavigate="(NavDestination _) => { }">
                <p>Today</p>
            </NavScreen>
        </Template>
    </Story>

    <Story Name="Breakfast">
        <Template>
            <AddSheet Open Clock="new FixedTimeProvider(new TimeOnly(8, 0))" OnSearch="(Meal _) => { }" OnScan="(Meal _) => { }" OnClose="() => { }" />
            <NavScreen Title="Calorie Tracker" Destination="NavDestination.Today" OnNavigate="(NavDestination _) => { }">
                <p>Today</p>
            </NavScreen>
        </Template>
    </Story>

    <Story Name="Lunch">
        <Template>
            <AddSheet Open Clock="new FixedTimeProvider(new TimeOnly(12, 30))" OnSearch="(Meal _) => { }" OnScan="(Meal _) => { }" OnClose="() => { }" />
            <NavScreen Title="Calorie Tracker" Destination="NavDestination.Today" OnNavigate="(NavDestination _) => { }">
                <p>Today</p>
            </NavScreen>
        </Template>
    </Story>

    <Story Name="Dinner">
        <Template>
            <AddSheet Open Clock="new FixedTimeProvider(new TimeOnly(18, 0))" OnSearch="(Meal _) => { }" OnScan="(Meal _) => { }" OnClose="() => { }" />
            <NavScreen Title="Calorie Tracker" Destination="NavDestination.Today" OnNavigate="(NavDestination _) => { }">
                <p>Today</p>
            </NavScreen>
        </Template>
    </Story>

    <Story Name="Snacks between meals">
        <Template>
            <AddSheet Open Clock="new FixedTimeProvider(new TimeOnly(16, 0))" OnSearch="(Meal _) => { }" OnScan="(Meal _) => { }" OnClose="() => { }" />
            <NavScreen Title="Calorie Tracker" Destination="NavDestination.Today" OnNavigate="(NavDestination _) => { }">
                <p>Today</p>
            </NavScreen>
        </Template>
    </Story>

    <Story Name="Snacks overnight">
        <Template>
            <AddSheet Open Clock="new FixedTimeProvider(new TimeOnly(22, 30))" OnSearch="(Meal _) => { }" OnScan="(Meal _) => { }" OnClose="() => { }" />
            <NavScreen Title="Calorie Tracker" Destination="NavDestination.Today" OnNavigate="(NavDestination _) => { }">
                <p>Today</p>
            </NavScreen>
        </Template>
    </Story>

</Stories>

@code {
    private static readonly IReadOnlyList<UsualFoodRow> UsualDinner =
    [
        new(1, "Chicken curry with rice", "350 g · 522 kcal"),
        new(2, "Margherita pizza", "1 serving · ½ pizza (201.8 g) · 521 kcal"),
        new(3, "Greek yoghurt", "150 g · 222 kcal"),
    ];
}
