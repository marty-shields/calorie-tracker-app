@using CalorieTracker.UI.Components.Layout
@attribute [Stories("Components/Layout/AddSheet")]

<Stories TComponent="AddSheet" Layout="typeof(PhoneLayout)">

    <Story Name="Breakfast">
        <Template>
            <AddSheet Open Clock="new FixedTimeProvider(new TimeOnly(8, 0))" OnSearch="(Meal _) => { }" OnScan="(Meal _) => { }" OnClose="() => { }" />
            <AppScreen Title="Calorie Tracker" Destination="NavDestination.Today" OnNavigate="(NavDestination _) => { }">
                <p>Today</p>
            </AppScreen>
        </Template>
    </Story>

