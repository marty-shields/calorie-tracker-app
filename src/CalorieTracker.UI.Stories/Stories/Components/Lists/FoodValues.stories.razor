@attribute [Stories("Components/Lists/FoodValues")]

<Stories TComponent="FoodValues" Layout="typeof(ThemeLayout)">

    <Story Name="Default">
        <Template>
            <FoodValues Name="Porridge oats" Brand="Morning Mill" Kcal="372" Protein="11" Carbs="60" Fat="8" TestId="food" />
        </Template>
    </Story>

    <Story Name="Liquid, no brand">
        <Template>
            <FoodValues Name="Semi-skimmed milk" IsLiquid Kcal="47" Protein="3.5" Carbs="4.8" Fat="1.7" TestId="food" />
        </Template>
    </Story>

    <Story Name="With extra nutrients">
        <Template>
            <FoodValues Name="Porridge oats" Brand="Morning Mill" Kcal="372" Protein="11" Carbs="60" Fat="8" Fibre="9" Sugars="1.1" Saturates="1.4" Salt="0.01" TestId="food" />
        </Template>
    </Story>

    <Story Name="With content under the rows">
        <Template>
            <FoodValues Name="Chocolate spread" Brand="Nutty Co" Kcal="250" Protein="6" Carbs="55" Fat="31" TestId="food">
                <p>Shown under the rows.</p>
            </FoodValues>
        </Template>
    </Story>

</Stories>
