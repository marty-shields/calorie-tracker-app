@attribute [Stories("Components/Lists/ListRow")]

<Stories TComponent="ListRow" Layout="typeof(ThemeLayout)">

    <Story Name="Default">
        <Template>
            <ListRow Text="Porridge oats" />
        </Template>
    </Story>

    <Story Name="With detail and aside">
        <Template>
            <ListRow Text="Porridge oats" Detail="Quaker" Aside="372 kcal / 100 g" />
        </Template>
    </Story>

    <Story Name="Tappable">
        <Template>
            <ListRow Text="Porridge oats" Detail="Quaker" Aside="372 kcal / 100 g" OnClick="() => { }" TestId="row" />
        </Template>
    </Story>

</Stories>
