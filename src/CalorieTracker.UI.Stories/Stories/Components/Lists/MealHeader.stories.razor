    <Story Name="With entries">
        <Template>
            <MealHeader Name="Breakfast" Calories="240" TestId="meal" />
        </Template>
    </Story>

    <Story Name="Empty">
        <Template>
            <MealHeader Name="Lunch" TestId="meal" />
        </Template>
    </Story>

    <Story Name="Long name">
