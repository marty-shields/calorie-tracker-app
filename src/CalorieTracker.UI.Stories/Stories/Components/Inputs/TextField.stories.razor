@attribute [Stories("Components/Inputs/TextField")]

<Stories TComponent="TextField" Layout="typeof(ThemeLayout)">

    <Story Name="Empty">
        <Template>
            <TextField Label="Serving name" Placeholder="Serving name, such as 1 slice" @bind-Value="empty" TestId="example-text" />
        </Template>
    </Story>

    <Story Name="With text">
        <Template>
            <TextField Label="Serving name" @bind-Value="filled" TestId="example-text" />
        </Template>
    </Story>

    <Story Name="Invalid">
        <Template>
            <TextField Label="Serving name" @bind-Value="invalid" InvalidMessage="Use 60 characters or fewer." TestId="example-text" />
        </Template>
    </Story>

    <Story Name="Disabled">
        <Template>
            <TextField Label="Serving name" @bind-Value="disabled" Disabled="true" TestId="example-text" />
        </Template>
    </Story>

</Stories>

@code {
    private string? empty;
    private string? filled = "1 slice";
    private string? invalid = "1 slice of the long cake";
    private string? disabled = "1 slice";
}
