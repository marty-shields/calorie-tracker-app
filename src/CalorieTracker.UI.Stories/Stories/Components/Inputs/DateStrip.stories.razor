@attribute [Stories("Components/Inputs/DateStrip")]

<Stories TComponent="DateStrip" Layout="typeof(ThemeLayout)">

    <Story Name="Today">
        <Template>
            <DateStrip Date="Today" Today="Today" />
        </Template>
    </Story>

    <Story Name="Yesterday">
        <Template>
            <DateStrip Date="Today.AddDays(-1)" Today="Today" />
        </Template>
    </Story>

    <Story Name="Tomorrow">
        <Template>
            <DateStrip Date="Today.AddDays(1)" Today="Today" />
        </Template>
    </Story>

    <Story Name="Far date">
        <Template>
            <DateStrip Date="new DateOnly(2027, 3, 5)" Today="Today" />
        </Template>
    </Story>

</Stories>

@code {
    // Fixed so the stories never change with the real date.
    private static readonly DateOnly Today = new(2026, 11, 15);
}
