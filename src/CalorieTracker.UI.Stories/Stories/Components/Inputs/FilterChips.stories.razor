@using CalorieTracker.Core.Data
@attribute [Stories("Components/Inputs/FilterChips")]

<Stories TComponent="FilterChips<Meal?>" Layout="typeof(ThemeLayout)">

    <Story Name="Breakfast chosen">
        <Template>
            <FilterChips TValue="Meal?" Label="Meal" Options="Options" Value="Meal.Breakfast" ValueChanged="(Meal? _) => { }" TestId="example-filter" />
        </Template>
    </Story>

    <Story Name="Snacks chosen">
        <Template>
            <FilterChips TValue="Meal?" Label="Meal" Options="Options" Value="Meal.Snacks" ValueChanged="(Meal? _) => { }" TestId="example-filter" />
        </Template>
    </Story>

    <Story Name="All chosen">
        <Template>
            <FilterChips TValue="Meal?" Label="Meal" Options="Options" Value="@((Meal?)null)" ValueChanged="(Meal? _) => { }" TestId="example-filter" />
        </Template>
    </Story>

</Stories>

@code {
    private static readonly IReadOnlyList<RadioOption<Meal?>> Options =
    [
        new(Meal.Breakfast, "Breakfast", "example-filter-breakfast"),
        new(Meal.Lunch, "Lunch", "example-filter-lunch"),
        new(Meal.Dinner, "Dinner", "example-filter-dinner"),
        new(Meal.Snacks, "Snacks", "example-filter-snacks"),
        new(null, "All", "example-filter-all"),
    ];
}
