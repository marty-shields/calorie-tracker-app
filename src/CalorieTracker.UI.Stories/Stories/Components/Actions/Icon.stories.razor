@attribute [Stories("Components/Actions/Icon")]

<Stories TComponent="Icon" Layout="typeof(ThemeLayout)">

    <Story Name="Chevron">
        <Template>
            <Icon Name="IconName.Chevron" />
        </Template>
    </Story>

    <Story Name="Muted">
        <Template>
            <Icon Name="IconName.Chevron" Tone="IconTone.Muted" />
        </Template>
    </Story>

    <Story Name="Search">
        <Template>
            <Icon Name="IconName.Search" Tone="IconTone.Muted" />
        </Template>
    </Story>

    <Story Name="Small">
        <Template>
            <Icon Name="IconName.Chevron" Tone="IconTone.Muted" Size="IconSize.Small" />
        </Template>
    </Story>

    <Story Name="Up">
        <Template>
            <Icon Name="IconName.Up" Tone="IconTone.Success" />
        </Template>
    </Story>

    <Story Name="Down">
        <Template>
            <Icon Name="IconName.Down" Tone="IconTone.Error" />
        </Template>
    </Story>

    <Story Name="Plus">
        <Template>
            @foreach (var size in Enum.GetValues<IconSize>())
            {
                foreach (var tone in Enum.GetValues<IconTone>())
                {
                    @($"{size} {tone}")
                    <Icon Name="IconName.Plus" Tone="tone" Size="size" />
                }
            }
        </Template>
    </Story>

    <Story Name="Minus">
        <Template>
            @foreach (var size in Enum.GetValues<IconSize>())
            {
                foreach (var tone in Enum.GetValues<IconTone>())
                {
                    @($"{size} {tone}")
                    <Icon Name="IconName.Minus" Tone="tone" Size="size" />
                }
            }
        </Template>
    </Story>

    <Story Name="ChevronLeft">
        <Template>
            @foreach (var size in Enum.GetValues<IconSize>())
            {
                foreach (var tone in Enum.GetValues<IconTone>())
                {
                    @($"{size} {tone}")
                    <Icon Name="IconName.ChevronLeft" Tone="tone" Size="size" />
                }
            }
        </Template>
    </Story>

</Stories>
