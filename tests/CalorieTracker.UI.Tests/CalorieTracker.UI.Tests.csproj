<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Shields.UI.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CalorieTracker.UI\CalorieTracker.UI.csproj" />
    <ProjectReference Include="..\..\src\CalorieTracker.UI.Stories\CalorieTracker.UI.Stories.csproj" />
  </ItemGroup>

  <!-- Where the tests find the kit components' scoped css: the package's static assets, or the checkout with UseKitSource. -->
  <PropertyGroup>
    <KitCssFolder Condition="'$(UseKitSource)' == 'true'">$(KitPath)/src/Shields.UI/wwwroot/css</KitCssFolder>
    <KitCssFolder Condition="'$(UseKitSource)' != 'true'">$(NuGetPackageRoot)shields.ui/$(ShieldsUiVersion.ToLowerInvariant())/staticwebassets/css</KitCssFolder>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KitCssFolder</_Parameter1>
      <_Parameter2>$(KitCssFolder)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Compile Include="..\..\src\CalorieTracker.App\Diagnostics\E2EClockPin.cs" Link="Scanning\E2EClockPin.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bunit" />
  </ItemGroup>

</Project>
