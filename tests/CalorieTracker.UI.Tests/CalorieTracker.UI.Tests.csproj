<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <!-- The kit's test helpers (Shields.UI.Testing: KitCss, KitNames, DesignTokens) comes from NuGet; -p:UseKitSource=true builds against the kit's source at KitPath instead. -->
  <ItemGroup Condition="'$(UseKitSource)' != 'true'">
    <PackageReference Include="Shields.UI.Testing" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseKitSource)' == 'true'">
    <ProjectReference Include="$(KitSourcePath)/src/Shields.UI.Testing/Shields.UI.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CalorieTracker.UI\CalorieTracker.UI.csproj" />
    <ProjectReference Include="..\..\src\CalorieTracker.UI.Stories\CalorieTracker.UI.Stories.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Compile Include="..\..\src\CalorieTracker.App\Diagnostics\E2EClockPin.cs" Link="Scanning\E2EClockPin.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bunit" />
  </ItemGroup>

</Project>
